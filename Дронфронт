-- ДРОНЫ
--========================================================--
local DroneFolder = Create("Folder", { Name = "AD_DF_Drones", Parent = PARENT })
local DroneESP = {}

local function getDroneType(obj)
    local n = obj.Name:lower()
    for _, t in ipairs(DroneTypes) do
        for _, kw in ipairs(t.keywords) do
            if n:find(kw) then return t.id end
        end
    end
    return nil
end

local function isDroneActive(obj)
    local dtype = getDroneType(obj)
    if not dtype then return false end
    return ActiveTypes[dtype] == true
end

local function createDroneESP(obj)
    if DroneESP[obj] then return end
    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not part then return end

    local hl = Create("Highlight", { FillColor = C.red, FillTransparency = 0.5, OutlineColor = Color3.new(1,1,1), OutlineTransparency = 0.3, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = obj, Parent = DroneFolder })
    local bb = Create("BillboardGui", { Size = UDim2.fromOffset(140, 16), StudsOffsetWorldSpace = Vector3.new(0, 2, 0), AlwaysOnTop = true, Adornee = part, Parent = DroneFolder })
    local lbl = Create("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "DRONE", TextColor3 = C.red, TextStrokeTransparency = 0.3, Font = Enum.Font.GothamBold, TextSize = 10, Parent = bb })
    DroneESP[obj] = { hl, bb, lbl }
end

local function removeDroneESP(obj)
    if DroneESP[obj] then for _, o in pairs(DroneESP[obj]) do pcall(function() o:Destroy() end) end; DroneESP[obj] = nil end
end

-- AIM
local function findAimTarget()
    local vp = Camera.ViewportSize; local center = Vector2.new(vp.X / 2, vp.Y / 2); local camPos = Camera.CFrame.Position; local best, bestScore = nil, S.AimFOV
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isDroneActive(obj) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (part.Position - camPos).Magnitude
                if dist <= S.AimRange then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if pd < bestScore then best = part; bestScore = pd end
                    end
                end
            end
        end
    end
    return best
end

-- ESP loop
task.spawn(function()
    while GUI and GUI.Parent do
        task.wait(0.5)
        if S.ESPEnabled then
            for _, obj in ipairs(workspace:GetDescendants()) do if getDroneType(obj) and not DroneESP[obj] then createDroneESP(obj) end end
            for obj in pairs(DroneESP) do if not obj.Parent or not isDroneActive(obj) then removeDroneESP(obj) end end
            for obj, data in pairs(DroneESP) do
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local dtype = getDroneType(obj) or "?"
                    local dist = math.floor((part.Position - Camera.CFrame.Position).Magnitude)
                    data[3].Text = string.format("%s · %dm", dtype:upper(), dist)
                end
            end
        else for obj in pairs(DroneESP) do removeDroneESP(obj) end end
    end
end)

-- FPS/PING
local lastFPS = 0; local lastPing = 0
task.spawn(function() while GUI and GUI.Parent do local frames = 0; local startTime = tick(); while tick() - startTime < 1 do RunService.RenderStepped:Wait(); frames = frames + 1 end; lastFPS = frames end end)
task.spawn(function() while GUI and GUI.Parent do local ok, ping = pcall(function() return LP:GetNetworkPing() end); if ok then lastPing = math.floor(ping * 1000) end; task.wait(0.5) end end)
task.spawn(function()
    while GUI and GUI.Parent do
        local parts = {}; if S.ShowFPS then table.insert(parts, "FPS: " .. lastFPS) end; if S.ShowPing then table.insert(parts, "Ping: " .. lastPing) end
        if #parts > 0 then StatsLabel.Text = table.concat(parts, "  |  "); StatsLabel.Visible = true else StatsLabel.Visible = false end
        WatermarkLabel.Visible = S.ShowWatermark; WatermarkSub.Visible = S.ShowWatermark
        OverlayHolder.Visible = S.ShowFPS or S.ShowPing or S.ShowWatermark
        task.wait(0.3)
    end
end)

-- AIM loop
bind(RunService.RenderStepped:Connect(function(dt)
    if S.AimEnabled then
        local targetPart = findAimTarget()
        if targetPart then
            local desired = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
            local smooth = math.clamp(S.AimSmooth * (dt * 60), 0.02, 1)
            Camera.CFrame = Camera.CFrame:Lerp(desired, smooth)
        end
    end
end))

