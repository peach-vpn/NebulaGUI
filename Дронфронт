    local sw = Create("Frame", { Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -44, 0.5, -9), BackgroundColor3 = state.v and C.accent or Color3.fromRGB(45, 45, 60), BorderSizePixel = 0, Parent = b }); Corner(sw, UDim.new(1, 0))
    local dot = Create("Frame", { Size = UDim2.fromOffset(12, 12), Position = state.v and UDim2.fromOffset(20, 3) or UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.fromRGB(240, 240, 250), BorderSizePixel = 0, ZIndex = 2, Parent = sw }); Corner(dot, UDim.new(1, 0))
    local function apply(instant) local col = state.v and C.accent or Color3.fromRGB(45, 45, 60); local pos = state.v and UDim2.fromOffset(20, 3) or UDim2.fromOffset(3, 3); if instant then sw.BackgroundColor3 = col; dot.Position = pos else Play(sw, TweenInfo.new(0.18), { BackgroundColor3 = col }); Play(dot, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = pos }) end end
    apply(true)
    b.MouseButton1Click:Connect(function() state.v = not state.v; apply(false); if cb then pcall(cb, state.v) end end)
