-- AIM LOCK
local function findAimTarget()
    local vp = Camera.ViewportSize; local center = Vector2.new(vp.X / 2, vp.Y / 2); local camPos = Camera.CFrame.Position; local best, bestScore = nil, S.AimFOV
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isDroneAimActive(obj) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (part.Position - camPos).Magnitude
                if dist <= S.AimRange then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if pd < bestScore then best = part; bestScore = pd end
                    end
                end
            end
        end
    end
    return best
end

