local function SelectTab(name)
    for tabName, item in pairs(Tabs) do
        local selected = tabName == name
        Play(item.Button, TweenInfo.new(0.15), { BackgroundColor3 = selected and C.card or C.panel })
        item.Bar.Visible = selected
