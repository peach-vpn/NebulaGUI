local function RenderESP()
    SectionTitle("ESP — Подсветка дронов")
    ToggleRow("Включить ESP", S.ESPEnabled, function(v) S.ESPEnabled = v end)
    SliderRow("Макс. дистанция", S.ESPMaxDist, 100, 5000, function(v) S.ESPMaxDist = v end)
    
    SectionTitle("ESP — Фильтр типов (Все выкл)")
    for _, t in ipairs(DroneTypes) do
        ToggleRow("Подсвечивать: " .. t.name, ActiveESPFilter[t.id], function(v) ActiveESPFilter[t.id] = v end)
    end
    InfoCard("Включите тумблер нужного дрона, чтобы увидеть его.")
end

local function RenderAim()
    SectionTitle("AIM Bot — Основное")
    ToggleRow("Включить AIM", S.AimEnabled, function(v) S.AimEnabled = v end)
    SliderRow("FOV (Радиус)", S.AimFOV, 20, 600, function(v) S.AimFOV = v end)
    SliderRow("Дистанция захвата", S.AimRange, 100, 3000, function(v) S.AimRange = v end)
    SliderRow("Плавность x100", math.floor(S.AimSmooth * 100), 1, 100, function(v) S.AimSmooth = v / 100 end)

    SectionTitle("AIM Bot — Фильтр целей (Все выкл)")
    for _, t in ipairs(DroneTypes) do
        ToggleRow("AIM: " .. t.name, ActiveAimFilter[t.id], function(v) ActiveAimFilter[t.id] = v end)
    end
    InfoCard("Аимбот наводится только на активные здесь дроны.")
end

local function RenderVisuals()
    SectionTitle("Интерфейс & Оверлей")
    ToggleRow("Показывать Watermark", S.ShowWatermark, function(v) S.ShowWatermark = v end)
    ToggleRow("Показывать FPS", S.ShowFPS, function(v) S.ShowFPS = v end)
    ToggleRow("Показывать Ping", S.ShowPing, function(v) S.ShowPing = v end)
    InfoCard("Иконку можно перетаскивать по экрану мышкой/пальцем.")
end

CreateTab("ESP", "👁", 1, RenderESP)
CreateTab("AIM", "🎯", 2, RenderAim)
CreateTab("Визуалы", "⚙", 3, RenderVisuals)

-- ОТКРЫТИЕ / ЗАКРЫТИЕ
local opened = false
local function SetOpen(state) 
    opened = state
    if opened then 
        Window.Visible = true; WindowScale.Scale = 0.9
        Play(WindowScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }) 
    else 
        Play(WindowScale, TweenInfo.new(0.15), { Scale = 0.9 })
        task.delay(0.15, function() Window.Visible = false end) 
    end 
end

IconBtn.MouseButton1Click:Connect(function() SetOpen(not opened) end)
CloseBtn.MouseButton1Click:Connect(function() SetOpen(false) end)

SelectTab("ESP")

_G.__DF2_CLEANUP = function()
    disconnectAll()
    pcall(function() GUI:Destroy() end)
    pcall(function() DroneFolder:Destroy() end)
end

