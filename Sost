local function Toggle(txt, initial, cb)
    local state = { v = initial }
    local b = Create("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.card, Text = "", AutoButtonColor = false, Parent = Content })
    Corner(b, UDim.new(0, 7)); Stroke(b, C.border, 1, 0.3)
    Create("TextLabel", { Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = txt, TextColor3 = C.text, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, Parent = b })
    local sw = Create("Frame", { Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -44, 0.5, -9), BackgroundColor3 = state.v and C.accent or Color3.fromRGB(45, 45, 60), Parent = b }); Corner(sw, UDim.new(1, 0))
    local dot = Create("Frame", { Size = UDim2.fromOffset(12, 12), Position = state.v and UDim2.fromOffset(20, 3) or UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sw }); Corner(dot, UDim.new(1, 0))
    local function apply(instant) local col = state.v and C.accent or Color3.fromRGB(45, 45, 60); local pos = state.v and UDim2.fromOffset(20, 3) or UDim2.fromOffset(3, 3); if instant then sw.BackgroundColor3 = col; dot.Position = pos else Play(sw, TweenInfo.new(0.15), { BackgroundColor3 = col }); Play(dot, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = pos }) end end
    apply(true)
    b.MouseButton1Click:Connect(function() state.v = not state.v; apply(false); if cb then pcall(cb, state.v) end end)
    return b
end

local function Slider(txt, initial, min, max, cb)
    local f = Create("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.card, Parent = Content })
    Corner(f, UDim.new(0, 7)); Stroke(f, C.border, 1, 0.3)
    Create("TextLabel", { Size = UDim2.new(0.6, -10, 0, 16), Position = UDim2.fromOffset(10, 4), BackgroundTransparency = 1, Text = txt, TextColor3 = C.text, TextSize = 11, Parent = f })
    local valLbl = Create("TextLabel", { Size = UDim2.new(0.4, -10, 0, 16), Position = UDim2.new(0.6, 0, 0, 4), BackgroundTransparency = 1, Text = tostring(initial), TextColor3 = C.accent, TextSize = 10, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, Parent = f })
    local track = Create("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 28), BackgroundColor3 = Color3.fromRGB(40, 40, 55), Parent = f }); Corner(track, UDim.new(1, 0))
    local fill = Create("Frame", { Size = UDim2.new((initial - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.accent, Parent = track }); Corner(fill, UDim.new(1, 0))
    local knob = Create("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new((initial - min) / (max - min), 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = track }); Corner(knob, UDim.new(1, 0)); Stroke(knob, C.accent, 2)
    local hit = Create("TextButton", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, -12), BackgroundTransparency = 1, Text = "", Parent = track })
    local dragging = false; local value = initial
    local function setX(x) local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); value = math.floor(min + rel * (max - min) + 0.5); fill.Size = UDim2.new(rel, 0, 1, 0); knob.Position = UDim2.new(rel, 0, 0.5, 0); valLbl.Text = tostring(value); if cb then pcall(cb, value) end end
    hit.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; Play(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(20, 20) }); setX(i.Position.X) end end)
    bind(UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setX(i.Position.X) end end))
    bind(UIS.InputEnded:Connect(function(i) if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then dragging = false; Play(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(14, 14) }) end end))
    return f
end

