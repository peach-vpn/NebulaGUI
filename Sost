            for obj in pairs(DroneESP) do if not obj.Parent then RemoveDroneESP(obj) end end
        else for obj in pairs(DroneESP) do RemoveDroneESP(obj) end end

        if S.ESPFragments then
            for _, obj in ipairs(workspace:GetDescendants()) do if IsFragment(obj) and not FragmentESP[obj] then CreateFragmentESP(obj) end end
            for obj in pairs(FragmentESP) do if not obj.Parent then RemoveFragmentESP(obj) end end
        else for obj in pairs(FragmentESP) do RemoveFragmentESP(obj) end end

        if S.ESPPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do CreatePlayerESP(plr) end
        end
    end
end)

-- AIM + Attack Target
local function FindAimTarget()
    local vp = Camera.ViewportSize; local center = Vector2.new(vp.X/2, vp.Y/2); local best, bestScore = nil, S.AimFOV
    for _, obj in ipairs(workspace:GetDescendants()) do
        if IsDrone(obj) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if pd < bestScore then best = part; bestScore = pd end
                end
            end
        end
    end
    return best
end

local accum = 0; local STEP = 1/25
bind(RunService.RenderStepped:Connect(function(dt)
    -- AIM
    if S.AimEnabled then
        local targetPart = FindAimTarget()
        if targetPart then
            local aimPos = targetPart.Position
            if S.AimPrediction then
                local vel = targetPart.AssemblyLinearVelocity
                if vel and vel.Magnitude > 1 then aimPos = aimPos + vel * 0.1 end
            end
            local desired = CFrame.lookAt(Camera.CFrame.Position, aimPos)
            local smooth = math.clamp(S.AimSmooth * (dt * 60), 0.02, 1)
            Camera.CFrame = Camera.CFrame:Lerp(desired, smooth)
        end
    end

    -- ESP Update (throttled)
    accum = accum + dt
    if accum >= STEP then
        accum = 0
        for plr, d in pairs(PlayerData) do
            if S.ESPPlayers and plr.Character and IsAlive(plr.Character) then
                d[2].Enabled = true; d[2].Adornee = plr.Character.Head or plr.Character.HumanoidRootPart
                d[3].Text = plr.Name; if S.AttackTarget == plr then d[3].Text = ">>> " .. plr.Name .. " <<<"; d[3].TextColor3 = C.yellow else d[3].TextColor3 = C.blue end
                d[1].Enabled = true; d[1].Adornee = plr.Character
            else
                d[1].Enabled = false; d[2].Enabled = false
            end
        end
    end
end))

-- Auto Collect
task.spawn(function()
    while GUI and GUI.Parent do
        task.wait(0.4)
        if S.AutoCollect then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local best, bestD = nil, math.huge
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if IsFragment(obj) and obj:IsA("BasePart") then
                        local d = (obj.Position - hrp.Position).Magnitude
                        if d < bestD and d < 500 then bestD = d; best = obj end
                    end
                end
                if best then pcall(function() hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0)) end) end
            end
        end
    end
end)

