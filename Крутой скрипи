local function Create(class, props)
    local o = Instance.new(class)
    local p = props.Parent
    for k, v in pairs(props) do if k ~= "Parent" then o[k] = v end end
    o.Parent = p
    return o
end
local function Corner(p, r) return Create("UICorner", { CornerRadius = r or UDim.new(0, 8), Parent = p }) end
local function Stroke(p, c, th, tr) return Create("UIStroke", { Color = c or C.border, Thickness = th or 1, Transparency = tr or 0.3, Parent = p }) end
local function Play(o, i, pr) TweenService:Create(o, i, pr):Play() end

local function guiParent()
    if gethui then local ok,h = pcall(gethui) if ok and h then return h end end
    if CoreGui then return CoreGui end
    return PlayerGui
end

local function isPlayerCharacter(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end

local function getRoot(model)
    return model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso"))
end

local function getNPCsInRange(range)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not isPlayerCharacter(obj) then
            local npcRoot = getRoot(obj)
            if npcRoot and (npcRoot.Position - root.Position).Magnitude <= range then
                table.insert(list, obj)
            end
        end
    end
    return list
end

local function findNearestNPC(range)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not isPlayerCharacter(obj) then
            local npcRoot = getRoot(obj)
            if npcRoot then
                local d = (npcRoot.Position - root.Position).Magnitude
                if d <= range and d < bestD then
                    bestD = d
                    best = obj
                end
            end
        end
    end
    return best
end

local function findTruck()
    local keywords = {S.TruckKeyword, "van", "getaway", "car", "vehicle"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) then
            local n = string.lower(obj.Name)
            for _, kw in ipairs(keywords) do
                if string.find(n, kw) then return obj end
            end
        end
    end
    return nil
end

