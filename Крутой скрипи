        Position = UDim2.new(1, -24, 0, 0),
        BackgroundTransparency = 1,
        Text = ">",
        TextColor3 = C.accent,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        Parent = b
    })

    b.MouseEnter:Connect(function() Play(b, TweenInfo.new(0.15), { BackgroundColor3 = C.cardHov }) end)
    b.MouseLeave:Connect(function() Play(b, TweenInfo.new(0.15), { BackgroundColor3 = C.card }) end)
    b.MouseButton1Click:Connect(function()
        Play(b, TweenInfo.new(0.08), { BackgroundColor3 = C.accent })
        task.delay(0.1, function() Play(b, TweenInfo.new(0.15), { BackgroundColor3 = C.card }) end)
        pcall(cb)
    end)
    return b
end

