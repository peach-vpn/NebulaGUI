local sleepingNPCs = {}
local activeBeating = false

local function createHitEffect(position)
    local part = Create("Part", {
        Size = Vector3.new(1, 1, 1),
        CFrame = CFrame.new(position),
        Anchored = true,
        CanCollide = false,
        Transparency = 0,
        Color = Color3.fromRGB(255, 50, 50),
        Material = Enum.Material.Neon,
        Parent = workspace,
    })
    Create("PointLight", {
        Color = Color3.fromRGB(255, 50, 50),
        Range = 6,
        Brightness = 3,
        Parent = part,
    })
    TweenService:Create(part, TweenInfo.new(0.4), {
        Size = Vector3.new(3, 3, 3),
        Transparency = 1,
    }):Play()
    task.delay(0.5, function() pcall(function() part:Destroy() end) end)
end

local function putToSleep(npc)
    if sleepingNPCs[npc] then return end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    sleepingNPCs[npc] = {
        WalkSpeed = hum.WalkSpeed,
        JumpPower = hum.JumpPower,
    }

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.PlatformStand = true

    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        track:Stop()
    end
    for _, part in ipairs(npc:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = math.min(part.Transparency + 0.5, 0.9)
        end
    end

    pcall(function()
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://180436148" -- fall
            local track = animator:LoadAnimation(anim)
            track:Play()
        end
    end)
end

local function wakeNPC(npc)
    local saved = sleepingNPCs[npc]
    if not saved then return end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = saved.WalkSpeed
        hum.JumpPower = saved.JumpPower
        hum.PlatformStand = false
    end
    for _, part in ipairs(npc:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = math.max(part.Transparency - 0.5, 0)
        end
    end
    sleepingNPCs[npc] = nil
end

-- Асинхронный процесс избиения
local function beatNPCSequence(npc)
    if activeBeating then return end
    activeBeating = true

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local npcRoot = getRoot(npc)
    
    if not hrp or not hum or not npcRoot then 
        activeBeating = false
        return 
    end

    -- ТП к NPC
    pcall(function()
        hrp.CFrame = CFrame.new(npcRoot.Position + Vector3.new(0, 1, -2))
    end)
    task.wait(0.3) -- Ждем прогрузки

    -- 5 Ударов
    for i = 1, 5 do
        if not npc.Parent then break end
        local pos = npcRoot.Position + Vector3.new(math.random(-1,1), 1, math.random(-1,1))
        createHitEffect(pos)
        
        pcall(function()
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://129967390" -- punch
                local track = animator:LoadAnimation(anim)
                track:Play()
            end
        end)
        
        task.wait(0.2) -- Интервал между ударами
    end

    -- Усыпляем
    putToSleep(npc)
    
    -- Ждем, пока NPC спит
    task.wait(S.SleepDuration)
    
    -- Будим
    if sleepingNPCs[npc] then
        wakeNPC(npc)
    end

    activeBeating = false
end

-- Цикл авто-избиения
local autoBeatTask = nil
local function startAutoBeat()
    if autoBeatTask then return end
    autoBeatTask = task.spawn(function()
        while GUI and GUI.Parent and S.AutoBeat do
            if not activeBeating then
                local npc = findNearestNPC(S.BeatRange)
                if npc then
                    beatNPCSequence(npc)
                end
            end
            task.wait(0.5)
        end
    end)
end

