-- Open/close
local opened = false
local function SetOpen(state)
    opened = state
    if opened then
        Window.Visible = true
        WindowScale.Scale = 0.9
        Play(WindowScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
    else
        Play(WindowScale, TweenInfo.new(0.15), { Scale = 0.9 })
        task.delay(0.15, function() Window.Visible = false end)
    end
end

Icon.MouseButton1Click:Connect(function() SetOpen(not opened) end)
CloseBtn.MouseButton1Click:Connect(function() SetOpen(false) end)

-- Drag
local dragging = false
local dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Window.Position
    end
end)
bind(UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
bind(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

