local function addHL(obj, kind)
    local hl = obj:FindFirstChild("CrimESP")
    if not hl then
        hl = Instance.new("Highlight"); hl.Name = "CrimESP"; hl.Adornee = obj
        hl.FillTransparency = 0.5; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = obj
    end
    hl.FillColor = COLORS[kind]; hl.OutlineColor = COLORS[kind]
    active[obj] = { hl = hl, kind = kind }
end

local function removeKind(kind)
    for obj, rec in pairs(active) do
        if rec.kind == kind then if rec.hl then rec.hl:Destroy() end; active[obj] = nil end
    end
end

local function inCharacter(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and obj:IsDescendantOf(p.Character) then return true end
    end
    return false
end

local function hasMark(obj)
    if lootMarks[obj] then return true end
    local parent = obj.Parent
    while parent and parent ~= Workspace do
        if lootMarks[parent] then return true end
        if (parent:IsA("Model") or parent:IsA("BasePart")) and LOOT_NAMES[parent.Name] then return true end
        parent = parent.Parent
    end
    return false
end

local function markLoot(obj, isSafe)
    if not obj.Parent or inCharacter(obj) or hasMark(obj) then return end
    local color = isSafe and COLORS.Safe or COLORS.Loot
    local hl = obj:FindFirstChild("CrimESP")
    if not hl then
        hl = Instance.new("Highlight"); hl.Name = "CrimESP"; hl.Adornee = obj
        hl.FillTransparency = 0.4; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = obj
    end
    hl.OutlineColor = color; hl.FillColor = color
    local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    local bb
    if part then
        bb = Instance.new("BillboardGui"); bb.Name = "CrimMark"; bb.Adornee = part
        bb.AlwaysOnTop = true; bb.Size = UDim2.new(0, 100, 0, 20); bb.StudsOffset = Vector3.new(0, 2, 0); bb.Parent = sg
        local t = Instance.new("TextLabel"); t.Size = UDim2.new(1, 0, 1, 0); t.BackgroundTransparency = 1
        t.Font = Enum.Font.GothamBold; t.TextSize = 12; t.TextColor3 = color; t.TextStrokeTransparency = 0.5
        t.Text = "◆ " .. obj.Name; t.Parent = bb
    end
    lootMarks[obj] = {hl = hl, bb = bb}
end

local function isLoot(d)
    if not (d:IsA("Model") or d:IsA("BasePart")) then return false, false end
    local name = d.Name
    if name == "SafeDialing" or name:find("Safe") then return true, true end
    if LOOT_NAMES[name] then return true, false end
    return false, false
end

local function scanLoot()
    for _, d in ipairs(Workspace:GetDescendants()) do
        local isL, isSafe = isLoot(d)
        if isL then markLoot(d, isSafe) end
    end
end

local lootConn = nil
local function setLoot(on)
    if lootConn then lootConn:Disconnect(); lootConn = nil end
    if on then
        scanLoot()
        lootConn = Workspace.DescendantAdded:Connect(function(d)
            if enabled.Loot then
                local isL, isSafe = isLoot(d)
                if isL then task.delay(0.2, function() markLoot(d, isSafe) end) end
            end
        end)
    else
        for obj, rec in pairs(lootMarks) do
            if rec.hl then rec.hl:Destroy() end; if rec.bb then rec.bb:Destroy() end; lootMarks[obj] = nil
        end
    end
end

local function clearAll()
    for obj, rec in pairs(active) do if rec.hl then rec.hl:Destroy() end; active[obj] = nil end
    for _, v in ipairs(Workspace:GetDescendants()) do if v.Name == "CrimESP" then v:Destroy() end end
    setLoot(false)
end

