-- ==========================================================
-- HELPERS
-- ==========================================================
local function Create(class, props)
    local o = Instance.new(class)
    local p = props.Parent
    for k, v in pairs(props) do if k ~= "Parent" then o[k] = v end end
    o.Parent = p
    return o
end

local function getGuiParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    return CoreGui
end

-- ==========================================================
-- BALL DETECTION (АДАПТИВНЫЙ)
-- ==========================================================
-- Ищем все объекты, похожие на шар. В Blade Ball шар может называться
-- по-разному в зависимости от режима/скина. Сканируем динамически.

local function isBallObject(obj)
    if not obj or not obj.Parent then return false end
    local name = obj.Name:lower()
    -- Ключевые слова для поиска шара
    local keywords = {"ball", "orb", "sphere", "projectile", "blade"}
    for _, kw in ipairs(keywords) do
        if name:find(kw) then
            -- Проверяем, что это физический объект
            if obj:IsA("BasePart") then return true end
            if obj:IsA("Model") and obj:FindFirstChildWhichIsA("BasePart", true) then return true end
        end
    end
    return false
end

local function getBallPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

-- ==========================================================
-- BALL ESP SYSTEM
-- ==========================================================
local espFolder = Create("Folder", { Name="BB_ESP_Folder", Parent=getGuiParent() })
local ballData = {}

local function destroyBallESP(ball)
    local data = ballData[ball]
    if not data then return end
    for _, inst in pairs(data) do
        if typeof(inst) == "Instance" then pcall(function() inst:Destroy() end) end
    end
    ballData[ball] = nil
end

local function createBallESP(ball)
