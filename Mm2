    })

    ballESPData[ball] = d
end

local function scanForBalls()
    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isBall(obj) then
            found[obj] = true
        end
    end
    return found
end

--========================================================--
-- PREDICTIVE AUTO HIT
--========================================================--
-- Логика:
--   1. Берём позицию и скорость шара
--   2. Предсказываем где он будет через AutoHitLeadTime секунд
--   3. Если расстояние от предсказанной точки до игрока < AutoHitRadius
--   4. Значит шар летит в нас — бьём
--
-- Удар: пробуем всё по очереди:
--   a) если в руке тул — tool:Activate()
--   b) если есть LocalScript / кнопка UI — VirtualInputManager нажатие
--   c) ремут — если найдём, можно дёрнуть
--
-- Под реальную игру оставь только то, что работает.

local lastAutoHit = 0
local hitTool = nil  -- в руке — определим динамически

local function getMyHrp()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function performHit(ball)
    local char = LP.Character
    if not char then return false end

    -- 1. тул в руке
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local ok = pcall(function() tool:Activate() end)
        if ok then return true end
    end

    -- 2. нажать ЛКМ / тап в сторону шара (попадём, если игра считает что мы бьём)
    --    многие игры требуют находиться рядом и жмякнуть — просто жмём
    pcall(function()
        local VirtualInputManager = game:GetService("VirtualInputManager")
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    return true
end

local function autoHitLoop()
    if not S.AutoHit then return end
    local now = tick()
    if now - lastAutoHit < S.AutoHitCooldown then return end

    local myHrp = getMyHrp()
    if not myHrp then return end

    for ball in pairs(ballESPData) do
        local part = getBallPart(ball)
        if part and part.Parent then
            local ballPos = part.Position
            local ballVel = part.AssemblyLinearVelocity

            -- предсказание позиции шара вперёд
            local predicted = ballPos + ballVel * S.AutoHitLeadTime
            local distToMe = (predicted - myHrp.Position).Magnitude
            local currentDist = (ballPos - myHrp.Position).Magnitude

            -- шар летит в нас и уже почти прилетел
            local flyingToMe = ballVel.Magnitude > 5 and (myHrp.Position - ballPos):Dot(ballVel.Unit) > 0

            if flyingToMe and (distToMe <= S.AutoHitRadius or currentDist <= S.AutoHitRadius) then
                if performHit(ball) then
                    lastAutoHit = now
                    return
                end
            end
        end
    end
end

