local function findMurderer()
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local camPos = Camera.CFrame.Position
    local best, bestScore = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local role = getRole(plr)
            if role == "Murderer" then
                local char = getCharacter(plr)
                if char and isAlive(char) then
                    local head = char:FindFirstChild("Head")
                    if head then
                        local dist = (head.Position - camPos).Magnitude
                        if dist <= S.AimRange then
                            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen and pos.Z > 0 then
                                local pixelDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                if pixelDist <= S.AimFOV and pixelDist < bestScore then
                                    local visible = true
                                    if S.AimWall then
                                        local filter = { Camera }
                                        if LP.Character then table.insert(filter, LP.Character) end
                                        local params = RaycastParams.new()
                                        params.FilterType = Enum.RaycastFilterType.Exclude
                                        params.FilterDescendantsInstances = filter
                                        local hit = workspace:Raycast(camPos, head.Position - camPos, params)
                                        visible = (not hit) or hit.Instance:IsDescendantOf(char)
                                    end
                                    if visible then
                                        best = plr
                                        bestScore = pixelDist
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

