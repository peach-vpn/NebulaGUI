local RoleCache = {}
local RoleNames = {
    ["murderer"] = "Murderer",
    ["sheriff"]  = "Sheriff",
    ["hero"]     = "Sheriff",
    ["innocent"] = "Innocent",
    ["civilian"] = "Innocent",
}

local function cacheRole(name, role)
    if not name or not role then return end
    local key = string.lower(tostring(role))
    local mapped = RoleNames[key] or tostring(role)
    RoleCache[name] = mapped
end

local function tryGetPlayerData()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            if n:find("data") or n:find("role") or n:find("player") or n:find("get") then
                local ok, data = pcall(function() return obj:InvokeServer() end)
                if ok and type(data) == "table" then
                    for k, v in pairs(data) do
                        if type(v) == "table" then
                            if v.Role then cacheRole(k, v.Role)
                            elseif v.role then cacheRole(k, v.role) end
                        elseif type(v) == "string" and type(k) == "string" then
                            cacheRole(k, v)
                        end
                    end
                end
            end
        end
    end
end

local function hookRoleEvents()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("role") or n:find("murder") or n:find("sheriff")
                or n:find("innocent") or n:find("assign") or n:find("start")
                or n:find("round") or n:find("game") or n:find("setrole") then
                pcall(function()
                    obj.OnClientEvent:Connect(function(...)
                        local args = {...}
                        for i = 1, #args do
                            local a = args[i]
                            if type(a) == "string" and RoleNames[a:lower()] then
                                for j = 1, #args do
                                    if args[j] ~= a and type(args[j]) == "string" then
                                        cacheRole(args[j], a)
                                    end
                                end
                            elseif type(a) == "table" then
                                for k, v in pairs(a) do
                                    if type(v) == "string" and RoleNames[v:lower()] then cacheRole(k, v) end
                                    if type(v) == "table" and (v.Role or v.role) then cacheRole(k, v.Role or v.role) end
                                end
                            elseif typeof(a) == "Instance" and a:IsA("Player") then
                                for j = 1, #args do
                                    local roleStr = args[j]
                                    if type(roleStr) == "string" and RoleNames[roleStr:lower()] then
                                        cacheRole(a.Name, roleStr)
                                    end
                                end
                            end
                        end
                    end)
                end)
            end
        end
    end
end

pcall(tryGetPlayerData)
pcall(hookRoleEvents)

task.spawn(function()
    while GUI and GUI.Parent do
