local function Slider(txt, initial, min, max, cb)
    local frame = Create("Frame", { Size=UDim2.new(1,0,0,40), BackgroundColor3=T.Sec, Parent=Content })
    Corner(frame, UDim.new(0, 5))
    local lbl = Create("TextLabel", { Size=UDim2.new(0.6,-8,0,18), Position=UDim2.fromOffset(8,2), BackgroundTransparency=1, Text=txt, TextColor3=T.Text, TextSize=11, Font=Enum.Font.GothamMedium, TextXAlignment=Enum.TextXAlignment.Left, Parent=frame })
    local valueLabel = Create("TextLabel", { Size=UDim2.new(0.4,-8,0,18), Position=UDim2.new(0.6,0,0,2), BackgroundTransparency=1, Text=string.format("%d/%d", math.floor(initial), max), TextColor3=T.Accent, TextSize=11, Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Right, Parent=frame })
    local track = Create("Frame", { Size=UDim2.new(1,-16,0,6), Position=UDim2.new(0,8,0,26), BackgroundColor3=Color3.fromRGB(40,44,54), BorderSizePixel=0, Parent=frame })
    Corner(track, UDim.new(1,0))
    local fill = Create("Frame", { Size=UDim2.new(0,0,1,0), BackgroundColor3=T.Accent, BorderSizePixel=0, Parent=track })
    Corner(fill, UDim.new(1,0))
    local knob = Create("Frame", { Size=UDim2.fromOffset(14,14), AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0,0,0.5,0), BackgroundColor3=Color3.fromRGB(240,244,255), BorderSizePixel=0, ZIndex=2, Parent=track })
    Corner(knob, UDim.new(1,0))
    Create("UIStroke", { Color=T.Accent, Thickness=2, Parent=knob })
    local hitbox = Create("TextButton", { Size=UDim2.new(1,0,0,28), Position=UDim2.new(0,0,0,-11), BackgroundTransparency=1, Text="", AutoButtonColor=false, Parent=track })
    reg(frame, "BackgroundColor3", "Sec")
    reg(lbl, "TextColor3", "Text")
    reg(valueLabel, "TextColor3", "Accent")
    reg(fill, "BackgroundColor3", "Accent")
    local value = math.clamp(initial, min, max)
    local dragging = false
    local function updateVisual(animate)
        local ratio = (value - min) / math.max(max - min, 1)
        if animate then
            Play(fill, TweenInfo.new(0.1), { Size = UDim2.new(ratio,0,1,0) })
            Play(knob, TweenInfo.new(0.1), { Position = UDim2.new(ratio,0,0.5,0) })
        else
            fill.Size = UDim2.new(ratio,0,1,0)
            knob.Position = UDim2.new(ratio,0,0.5,0)
        end
        valueLabel.Text = string.format("%d/%d", math.floor(value), max)
    end
    local function setFromX(x)
        local trackAbs = track.AbsolutePosition
        local trackSize = track.AbsoluteSize.X
        if trackSize <= 0 then return end
        local rel = math.clamp((x - trackAbs.X) / trackSize, 0, 1)
        value = min + rel * (max - min)
        updateVisual(false)
        if cb then pcall(cb, value) end
    end
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Play(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(20,20) })
            setFromX(input.Position.X)
        end
    end)
    bind(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end))
    bind(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Play(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(14,14) })
            end
        end
    end))
    updateVisual(true)
    return frame
end

