--// =========================================================
--// AUTO GUN / SPECTATE / INFINITE JUMP
--// =========================================================
local gunTaskRunning = false
local lastGunPickTime = 0

bind(RunService.Heartbeat:Connect(function(dt)
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- AUTO GUN НА СМЕРТЬ ШЕРИФА
    if S.AutoGunOnSheriffDeath and myHrp and not gunTaskRunning then
        local now = tick()
        if now - lastGunPickTime > 1 then
            local bestGun, bestDist = nil, math.huge
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Tool") then
                    local n = obj.Name:lower()
                    if n:find("gun") or n:find("pistol") or n:find("revolver") then
                        local handle = obj:FindFirstChild("Handle")
                        if handle then
                            local d = (handle.Position - myHrp.Position).Magnitude
                            if d < bestDist and d < 500 then
                                bestDist = d
                                bestGun = handle
                            end
                        end
                    end
                end
            end

            if bestGun then
                gunTaskRunning = true
                task.spawn(function()
                    local savedPos = myHrp.CFrame
                    S.GunSavedPos = savedPos

                    pcall(function()
                        myHrp.CFrame = CFrame.new(bestGun.Position + Vector3.new(0, 2, 0))
                    end)

                    task.wait(0.5)

                    if S.GunSavedPos then
                        task.wait(S.GunReturnDelay)
                        pcall(function()
                            local curChar = LP.Character
                            local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                            if curHrp then
                                curHrp.CFrame = S.GunSavedPos
                            end
                        end)
                    end

                    lastGunPickTime = tick()
                    gunTaskRunning = false
                end)
            end
        end
    end

    -- SPECTATE
    if S.SpectateMurderer and Camera then
        local found = false
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and getRole(plr) == "Murderer" then
                local tchar = plr.Character
                local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
                if thum then
                    Camera.CameraSubject = thum
                    found = true
                end
                break
            end
        end
        if not found and myHum and Camera.CameraSubject ~= myHum then
            Camera.CameraSubject = myHum
        end
    elseif myHum and Camera and Camera.CameraSubject ~= myHum then
        Camera.CameraSubject = myHum
    end

    -- INFINITE JUMP
    if S.InfiniteJump and myHum then
        if UIS:IsKeyDown(Enum.KeyCode.Space) or myHum:GetState() == Enum.HumanoidStateType.Jumping then
            myHum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end))

--// =========================================================
--// ГЛАВНЫЙ ЦИКЛ (ESP + AIM)
--// =========================================================
local accum = 0
local UPDATE_STEP = 1/20

bind(RunService.RenderStepped:Connect(function(dt)
    -- AIM
    if S.AimAuto then
        local target = findMurderer()
        if target then
            local char = getCharacter(target)
            local head = char and char:FindFirstChild("Head")
            if head then
                local desired = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                if S.AimSmooth >= 0.99 then
                    Camera.CFrame = desired
                else
                    local sm = math.clamp(S.AimSmooth * (dt * 60), 0.05, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(desired, sm)
                end
            end
        end
    end

    -- ESP throttled
    accum = accum + dt
    if accum >= UPDATE_STEP then
        accum = 0
        if S.ESPMurderer or S.ESPSheriff or S.ESPInnocent or S.ESPGun then
            for plr, d in pairs(ESPData) do
                local role = getRole(plr)
                local char = getCharacter(plr)
                local showRole =
                    (role == "Murderer" and S.ESPMurderer) or
                    (role == "Sheriff" and S.ESPSheriff) or
                    (role ~= "Murderer" and role ~= "Sheriff" and S.ESPInnocent)

                if char and isAlive(char) and showRole then
                    local root = getRoot(char)
                    local head = getHead(char)
                    local camPos = Camera.CFrame.Position
                    if root then
                        local distance = (root.Position - camPos).Magnitude
                        if distance > S.ESPMaxDistance then
                            d.Info.Enabled = false
                            d.Highlight.Enabled = false
                        else
                            d.Info.Enabled = true
                            d.Info.Adornee = head or root
                            d.Info.MaxDistance = S.ESPMaxDistance

                            local color = role == "Murderer" and COLOR_MURDERER
                                       or role == "Sheriff" and COLOR_SHERIFF
                                       or COLOR_INNOCENT

                            d.Name.Text = plr.Name
                            d.Name.TextColor3 = color
                            d.Role.Text = role == "Murderer" and "УБИЙЦА"
                                          or role == "Sheriff" and "ШЕРИФ"
                                          or "МИРНЫЙ"
                            d.Role.TextColor3 = color
                            d.Role.Visible = true

                            d.Dist.Text = string.format("%d м", math.floor(distance))
                            d.Dist.Visible = S.ESPDistance
                            d.Name.Visible = S.ESPName

                            d.Highlight.Enabled = S.ESPHighlight
                            d.Highlight.FillColor = color
                            d.Highlight.Adornee = char
                        end
                    end
                else
                    d.Info.Enabled = false
                    d.Highlight.Enabled = false
                end
            end
        else
            for _, d in pairs(ESPData) do
                d.Info.Enabled = false
                d.Highlight.Enabled = false
            end
        end
    end
end))

--// =========================================================
--// SPEED/JUMP/NOCLIP
--// =========================================================
local humanoidHooks = {}
local function hookHumanoid(hum)
    if humanoidHooks[hum] then return end
    humanoidHooks[hum] = true
    local c1 = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if S.SpeedBoost and hum.WalkSpeed ~= S.SpeedValue then hum.WalkSpeed = S.SpeedValue end
    end)
    local c2 = hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if S.JumpBoost and hum.JumpPower ~= S.JumpValue then hum.JumpPower = S.JumpValue end
    end)
    bind(c1) bind(c2)
end

bind(RunService.Stepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hookHumanoid(hum)
    if S.SpeedBoost then
        if hum.WalkSpeed ~= S.SpeedValue then hum.WalkSpeed = S.SpeedValue end
    else
        if hum.WalkSpeed ~= 16 then hum.WalkSpeed = 16 end
    end
    hum.UseJumpPower = true
    if S.JumpBoost then
        if hum.JumpPower ~= S.JumpValue then hum.JumpPower = S.JumpValue end
    else
        if hum.JumpPower ~= 50 then hum.JumpPower = 50 end
    end
    if S.NoClip then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then pcall(function() d.CanCollide = false end) end
        end
    end
end))

