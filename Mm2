--========================================================--
-- BALL DETECTION — адаптируй под реальную игру
--========================================================--
-- По умолчанию ищем в workspace объекты с именем содержащим "ball" / "шар"
-- и у которых есть BasePart внутри. Если в игре шар — это модель "DeathBall"
-- или папка "Balls" — подкрути функцию.

local function isBall(obj)
    if not obj or not obj.Parent then return false end
    local n = obj.Name:lower()
    if not (n:find("ball") or n:find("шар") or n:find("sphere") or n:find("orb")) then
        return false
    end
    if obj:IsA("BasePart") then return true end
    if obj:IsA("Model") then
        return obj:FindFirstChildWhichIsA("BasePart", true) ~= nil
    end
    return false
end

local function getBallPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

