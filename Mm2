local function scanForBalls()
    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isBallObject(obj) then
            found[obj] = true
        end
    end
    return found
end

-- ==========================================================
-- PARRY REMOTE DETECTION
-- ==========================================================
local parryRemote = nil

local function findParryRemote()
    -- Ищем ремут для парри
    local searchPaths = {
        {ReplicatedStorage, "Remotes", "ParryButtonPress"},
        {ReplicatedStorage, "Remotes", "Parry"},
        {ReplicatedStorage, "RemoteEvents", "Parry"},
    }
    
    for _, path in ipairs(searchPaths) do
        local obj = path[1]
        for i = 2, #path do
            obj = obj:FindFirstChild(path[i])
            if not obj then break end
        end
        if obj and obj:IsA("RemoteEvent") then
            parryRemote = obj
            print("[BB] Parry remote found:", obj:GetFullName())
            return
        end
    end
    
    -- Fallback: сканируем всё
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = obj.Name:lower()
            if n:find("parry") or n:find("block") or n:find("deflect") then
                parryRemote = obj
                print("[BB] Parry remote (fallback):", obj:GetFullName())
                return
            end
        end
    end
end

findParryRemote()

-- ==========================================================
-- AUTO PARRY ENGINE
-- ==========================================================
local lastParry = 0
local lastBallTarget = nil

local function getMyHrp()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getPing()
    local ok, ping = pcall(function() return LP:GetNetworkPing() end)
    return ok and ping or 0.06
end

local function doParry()
    -- Метод 1: Remote (самый быстрый и безопасный)
    if S.ParryMethod == "remote" and parryRemote then
        pcall(function() parryRemote:FireServer() end)
        return true
    end
    
    -- Метод 2: Мобильный тач (по умолчанию на телефоне)
    if S.ParryMethod == "touch" or S.ParryMethod == "auto" then
        pcall(function()
            local vp = Camera.ViewportSize
            local center = Vector2.new(vp.X / 2, vp.Y / 2)
            
            -- Рандомизируем позицию тапа для анти-детекта
            local offset = Vector2.new(
                math.random(-30, 30),
                math.random(-30, 30)
            )
            local tapPos = center + offset
            
            VirtualInputManager:SendTouchEvent(
                1, -- TouchId
                Enum.UserInputState.Begin,
                tapPos,
                tapPos,
                Vector3.zero,
                game
            )
            task.wait(0.03)
            VirtualInputManager:SendTouchEvent(
                1,
                Enum.UserInputState.End,
                tapPos,
                tapPos,
                Vector3.zero,
                game
            )
        end)
        return true
    end
    
    return false
end

local function calculateParryWindow(ballPart, myHrp)
    -- Предиктивная логика
    local ballPos = ballPart.Position
    local ballVel = ballPart.AssemblyLinearVelocity
    local myPos = myHrp.Position
    
    -- Вектор от шара ко мне
    local toMe = myPos - ballPos
    local distance = toMe.Magnitude
    
    -- Проверка: летит ли шар в меня?
    if ballVel.Magnitude < 5 then return false, distance end
    
    local dot = toMe.Unit:Dot(ballVel.Unit)
    if dot < 0.3 then return false, distance end -- Шар летит не в меня
    
    -- Время до контакта (с учётом пинга)
    local speed = ballVel.Magnitude
    local ping = getPing()
    local timeToContact = (distance / speed) - ping
    
    -- Предиктивная позиция шара
    local predictedPos = ballPos + ballVel * timeToContact
    
    -- Финальная дистанция
    local finalDist = (predictedPos - myPos).Magnitude
    
    -- Учитываем точность
    local accuracyMod = S.ParryAccuracy / 100
    local effectiveRange = S.ParryRange * (0.8 + accuracyMod * 0.4)
    
    return finalDist <= effectiveRange, finalDist
end

local function autoParryLoop()
    if not S.AutoParry then return end
    
    local now = tick()
    local cooldown = S.ParryCooldown
    
    -- Рандомизация кулдауна для анти-детекта
    if S.RandomizeDelay then
        cooldown = cooldown * (0.7 + math.random() * 0.6)
    end
    
    if now - lastParry < cooldown then return end
    
    local myHrp = getMyHrp()
    if not myHrp then return end
    
    -- Ищем угрозу
    local bestBall, bestTime = nil, math.huge
    
    for ball, data in pairs(ballData) do
        local part = getBallPart(ball)
        if part and part.Parent then
            local shouldParry, dist = calculateParryWindow(part, myHrp)
            if shouldParry then
                local timeToReach = dist / math.max(part.AssemblyLinearVelocity.Magnitude, 1)
                if timeToReach < bestTime then
                    bestTime = timeToReach
                    bestBall = ball
                end
            end
        end
    end
    
    if bestBall then
        -- Рандомизация задержки перед парри
        if S.RandomizeDelay then
            local jitter = math.random(0, 3) * 0.01
            task.wait(jitter)
        end
        
        if doParry() then
            lastParry = now
            lastBallTarget = bestBall
        end
    end
end

-- ==========================================================
-- ESP UPDATE LOOP
-- ==========================================================
local espAccum = 0
local ESP_STEP = 1/30

local function updateESP()
    local myHrp = getMyHrp()
    if not myHrp then return end
    
    for ball, data in pairs(ballData) do
        local part = getBallPart(ball)
        if part and part.Parent then
            local dist = (part.Position - myHrp.Position).Magnitude
            
            if dist > S.BallMaxDistance then
                data.Billboard.Enabled = false
                data.Highlight.Enabled = false
            else
                data.Billboard.Enabled = true
                data.Billboard.Adornee = part
                data.Highlight.Enabled = S.BallHighlight
                data.Highlight.Adornee = part
                data.Dist.Text = string.format("%d м", math.floor(dist))
                
                -- Скорость
                local speed = part.AssemblyLinearVelocity.Magnitude
                data.Speed.Text = string.format("%d st/s", math.floor(speed))
                
                -- Цвет обводки: красный если летит в меня
                local ballVel = part.AssemblyLinearVelocity
                local toMe = myHrp.Position - part.Position
                local flyingToMe = ballVel.Magnitude > 5 and toMe:Dot(ballVel.Unit) > 0.3
                
                if flyingToMe then
                    data.Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    data.Title.Text = "⚠️ В ТЕБЯ"
                else
                    data.Highlight.FillColor = Color3.fromRGB(255, 100, 60)
                    data.Title.Text = "ШАР"
                end
            end
        else
            data.Billboard.Enabled = false
            data.Highlight.Enabled = false
        end
    end
end

-- ==========================================================
-- BALL SCANNER LOOP
-- ==========================================================
task.spawn(function()
    while true do
        task.wait(0.4)
        if S.BallESP then
            local found = scanForBalls()
            for ball in pairs(found) do
                if not ballData[ball] then createBallESP(ball) end
            end
            for ball in pairs(ballData) do
                if not found[ball] or not ball.Parent then destroyBallESP(ball) end
            end
        else
            for ball in pairs(ballData) do destroyBallESP(ball) end
        end
    end
end)

-- ==========================================================
-- MAIN LOOPS
-- ==========================================================
-- ESP update
bind(RunService.RenderStepped:Connect(function(dt)
    espAccum = espAccum + dt
    if espAccum >= ESP_STEP then
        espAccum = 0
        pcall(updateESP)
    end
end))

-- Auto Parry loop (Heartbeat для точности)
bind(RunService.Heartbeat:Connect(function()
    pcall(autoParryLoop)
end))

