local function removeBallESP(ball)
    local d = ballESPData[ball]
    if not d then return end
    for _, obj in pairs(d) do
        if typeof(obj) == "Instance" then pcall(function() obj:Destroy() end) end
    end
    ballESPData[ball] = nil
end

