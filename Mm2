local function getRole(plr)
    if RoleCache[plr.Name] then return RoleCache[plr.Name] end
    local char = plr.Character
    if not char then return "Innocent" end

    local role = plr:GetAttribute("Role") or plr:GetAttribute("role")
    if role then
        cacheRole(plr.Name, role)
        return RoleNames[tostring(role):lower()] or tostring(role)
    end
    role = char:GetAttribute("Role") or char:GetAttribute("role")
    if role then
        cacheRole(plr.Name, role)
        return RoleNames[tostring(role):lower()] or tostring(role)
    end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("dagger") or n:find("sword") then
            cacheRole(plr.Name, "Murderer") return "Murderer"
        end
        if n:find("gun") or n:find("pistol") or n:find("revolver") then
            cacheRole(plr.Name, "Sheriff") return "Sheriff"
        end
    end

    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("dagger") then
                    cacheRole(plr.Name, "Murderer") return "Murderer"
                end
                if n:find("gun") or n:find("pistol") then
                    cacheRole(plr.Name, "Sheriff") return "Sheriff"
                end
            end
        end
    end

    return "Innocent"
end

