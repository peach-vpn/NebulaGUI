-- Ball ESP update + warning
local espAccum = 0
bind(RunService.RenderStepped:Connect(function(dt)
    espAccum = espAccum + dt
    if espAccum < 1/30 then return end
    espAccum = 0

    local myHrp = getMyHrp()
    for ball, d in pairs(ballESPData) do
        local part = getBallPart(ball)
        if part and part.Parent and myHrp then
            local dist = (part.Position - myHrp.Position).Magnitude
            if dist > S.BallMaxDistance then
                d.Info.Enabled = false
                d.Highlight.Enabled = false
            else
                d.Info.Enabled = true
                d.Info.Adornee = part
                d.Highlight.Enabled = S.BallHighlight
                d.Highlight.Adornee = part
                d.Dist.Text = string.format("%d м", math.floor(dist))

                -- предупреждение если летит в нас
                local vel = part.AssemblyLinearVelocity
                local toMe = myHrp.Position - part.Position
                local flying = vel.Magnitude > 5 and toMe:Dot(vel.Unit) > 0
                local predicted = part.Position + vel * S.AutoHitLeadTime
                local pd = (predicted - myHrp.Position).Magnitude

                if flying and pd <= S.AutoHitRadius * 1.5 then
                    d.Warning.Text = "ЛЕТИТ В ТЕБЯ"
                    d.Title.TextColor3 = Color3.fromRGB(255, 0, 0)
                else
                    d.Warning.Text = ""
                    d.Title.TextColor3 = S.BallColor
                end
            end
        else
            d.Info.Enabled = false
            d.Highlight.Enabled = false
        end
    end
end))

-- Auto hit loop
bind(RunService.Heartbeat:Connect(function()
    if S.AutoHit then pcall(autoHitLoop) end
end))

