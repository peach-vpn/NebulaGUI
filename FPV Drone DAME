local function Toggle(txt, initial, cb)
    local state = {v=initial}
    local b = Create("TextButton", {Size=UDim2.new(1,0,0,28), BackgroundColor3=TT.Sec, Text="", AutoButtonColor=false, Parent=Content})
    Corner(b, UDim.new(0,6))
