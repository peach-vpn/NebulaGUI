--// ---------------- MAIN LOOP ----------------
local accum = 0
local tracerTarget = nil

bind(RunService.RenderStepped:Connect(function(dt)
    aimStep(dt)
    accum = accum + dt
    local step = 1 / math.max(S.RefreshRate, 1)
    if accum < step then
        if S.Tracer and S.ESP and tracerTarget then updateTracer(tracerTarget.plr, tracerTarget.part) else TracerFrame.Visible=false end
        return
    end
    accum = 0
    tracerTarget = nil

    if not S.ESP then
        for _, d in pairs(ESPData) do d.Info.Enabled=false d.Highlight.Enabled=false d.Box.Visible=false end
        TracerFrame.Visible = false
        return
    end

    local camPos = Camera and Camera.CFrame.Position or Vector3.zero
    local bestTracerDist = math.huge
    for plr, d in pairs(ESPData) do
        if not isEnemy(plr) or not isTargetable(plr) then
            d.Info.Enabled=false d.Highlight.Enabled=false d.Box.Visible=false
        else
            local c = getChar(plr)
            local root = getRoot(c); local hum = getHum(c); local head = getHead(c)
            local drone = findDronePart(c)
            local anchor = root or drone
            if anchor then
                local dist = (anchor.Position - camPos).Magnitude
                if dist > S.MaxDistance then
                    d.Info.Enabled=false d.Highlight.Enabled=false d.Box.Visible=false
                else
                    d.Highlight.Enabled = S.Highlight
                    if S.Highlight then
                        d.Highlight.Adornee = c
                        local t = math.clamp(dist/S.MaxDistance,0,1)
                        d.Highlight.FillColor = Color3.fromRGB(255, math.floor(255*(1-t)*0.7+60), math.floor(60*(1-t)))
                    end
                    d.Box.Visible = S.Box
                    if S.Box then
                        d.Box.Adornee = anchor
                        d.Box.Size = Vector3.new(2,3,1)
                        d.Box.Color3 = S.BoxColor
                    else d.Box.Adornee = nil end
                    d.Info.Enabled = true
                    d.Info.Adornee = head or drone or root
                    d.Info.MaxDistance = S.MaxDistance
                    d.Name.Visible = S.Name
                    d.Name.Text = plr.Name
                    d.Dist.Visible = S.Distance
                    d.Dist.Text = string.format("%d m", math.floor(dist))
                    if S.Health and hum then
                        d.HPBack.Visible = true
                        local r = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                        d.HPFill.Size = UDim2.fromScale(r,1)
                        d.HPFill.BackgroundColor3 = r>0.5 and Color3.fromRGB(60,255,100) or r>0.25 and Color3.fromRGB(255,200,60) or Color3.fromRGB(255,60,60)
                    else d.HPBack.Visible = false end
                    if S.Tracer and dist < bestTracerDist then
                        bestTracerDist = dist
                        tracerTarget = {plr=plr, part=head or drone or root}
                    end
                end
            end
        end
    end
    if S.Tracer and S.ESP and tracerTarget then updateTracer(tracerTarget.plr, tracerTarget.part) else TracerFrame.Visible=false end
end))

