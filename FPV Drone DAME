--// ---------------- CHARACTER CACHE ----------------
local CharCache = {}
local function setChar(plr, char)
    CharCache[plr] = char
    if not char then return end
    bind(char.AncestryChanged:Connect(function(_, parent) if not parent then CharCache[plr]=nil end end))
end
local function watch(plr)
    if plr == LP then return end
    setChar(plr, plr.Character)
    bind(plr.CharacterAdded:Connect(function(c) task.wait(0.2) setChar(plr, c) end))
    bind(plr.CharacterRemoving:Connect(function() CharCache[plr]=nil end))
end
for _, p in ipairs(Players:GetPlayers()) do watch(p) end
bind(Players.PlayerAdded:Connect(watch))
bind(Players.PlayerRemoving:Connect(function(p) CharCache[p]=nil end))

local function getChar(p) return CharCache[p] end
local function getRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")) end
local function getHum(c) return c and c:FindFirstChildOfClass("Humanoid") end
local function getHead(c) return c and c:FindFirstChild("Head") end

local function findDronePart(char)
    if not char then return nil end
    local names = {"Drone","FPV","FPVDrone","DroneRoot","DroneBody","DroneCamera","Camera","Rotor"}
    for _, nm in ipairs(names) do
        for _, d in ipairs(char:GetDescendants()) do
            if d.Name == nm and d:IsA("BasePart") then return d end
            if d.Name == nm and d:IsA("Model") then
                local pp = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                if pp then return pp end
            end
        end
    end
    if not char:FindFirstChildOfClass("Humanoid") then
        return char.PrimaryPart or char:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function isTargetable(plr)
    if not plr or plr==LP or not plr.Parent then return false end
    local c = CharCache[plr]
    if not c or not c.Parent or not c:IsDescendantOf(workspace) then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h and h.Health<=0 then return false end
    return true
end
local function isEnemy(plr)
    if not plr or plr==LP then return false end
    if S.IgnoreTeam and LP.Team and plr.Team and LP.Team==plr.Team then return false end
    return true
end

