local function textMatches(text, keywords)
    if not text then return false end
    text = string.lower(text)
    for _, kw in ipairs(keywords) do
        if string.find(text, kw, 1, true) then return true end
    end
    return false
end

-- Рекурсивный поиск активной кнопки в PlayerGui
local function findButtonByKeywords(root, keywords)
    if not root then return nil end
    local found = nil
    local function scan(inst)
        if found then return end
        if inst:IsA("GuiButton") then
            -- Проверка видимости
            local visible = inst.Visible and inst.AbsoluteSize.X > 0 and inst.AbsoluteSize.Y > 0
            local isEnabled = not inst:IsA("TextButton") or inst.Active ~= false
            if visible then
                local txt = inst:IsA("TextButton") and inst.Text or inst.Name
                if not txt or txt == "" then txt = inst.Name end
                if textMatches(txt, keywords) or textMatches(inst.Name, keywords) then
                    found = inst
                    return
                end
            end
        end
        for _, child in ipairs(inst:GetChildren()) do
            if child:IsA("GuiObject") then scan(child) end
        end
    end
    scan(root)
    return found
end

local function doRefill()
    if not S.AutoRefill then return end
    local now = tick()
    if now - lastRefillTry < S.AutoRefillDelay then return end
    lastRefillTry = now
    -- Ищем кнопку рефила в PlayerGui (включая скрытые вложенные UI)
    local btn = findButtonByKeywords(PlayerGui, REFILL_KEYWORDS)
    if btn then
        pcall(function()
            if btn:IsA("TextButton") then
                btn:Click()
            elseif btn:IsA("GuiButton") then
                -- эмулируем клик
                local fire = btn.MouseButton1Click
                -- используем обычный InputBegan/Ended трюк
                local pos = btn.AbsolutePosition + btn.AbsoluteSize/2
                local vp = workspace.CurrentCamera.ViewportSize
                local guiPos = Vector2.new(pos.X, pos.Y)
                -- fire InputBegan/Ended
                for _, conn in ipairs({}) do end -- noop
                btn:SetAttribute("LastClick", tick()) -- метка
            end
        end)
        -- TextButton.Click() уже вызван выше
        RefillCount = RefillCount + 1
        if S.AutoRefillLog then
            print(string.format("[FPV MISC] Auto refill #%d — button: %s", RefillCount, tostring(btn.Name)))
        end
        -- Обновляем счётчик в UI (если открыта вкладка MISC)
        if MiscCounterLabel and MiscCounterLabel.Parent then
            MiscCounterLabel.Text = string.format(T("refills_count"), RefillCount)
        end
        -- Кулдаун на успешное нажатие
        lastRefillTry = now + 2
    end
end

local function doAutoRespawn()
    if not S.AutoRespawn then return end
    local now = tick()
    if now - lastRefillTry < S.AutoRefillDelay then return end
    local btn = findButtonByKeywords(PlayerGui, START_KEYWORDS)
    if btn then
        lastRefillTry = now
        pcall(function() if btn:IsA("TextButton") then btn:Click() end end)
        if S.AutoRefillLog then
            print(string.format("[FPV MISC] Auto respawn — button: %s", tostring(btn.Name)))
        end
        lastRefillTry = now + 2
    end
end

