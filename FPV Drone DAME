local LockedTarget, HoldActive = nil, false
local LastSwitch = 0
local TARGET_SWITCH_CD = 0.15

local function getAimPart(char, mode)
    if not char then return nil end
    if mode=="fpv" then
        local dp = findDronePart(char)
        return dp or getRoot(char) or getHead(char)
    else
        return getHead(char) or getRoot(char)
    end
end
local function predictPos(part)
    if not part then return nil end
    local v = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    local t = dist/500
    return part.Position + v*(S.AimPred*t)
end
local function pixelScore(part)
    if not Camera then return math.huge end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or pos.Z<=0 then return math.huge end
    local vp = Camera.ViewportSize
    local c = Vector2.new(vp.X/2, vp.Y/2)
    local d = (Vector2.new(pos.X,pos.Y)-c).Magnitude
    if d > S.AimFOV then return math.huge end
    return d
end
local function gatherCandidates()
    local list = {}
    if not Camera then return list end
    local camPos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) and isTargetable(plr) then
            local char = getChar(plr)
            if char then
                if S.AimPlayers then
                    local p = getAimPart(char, "players")
                    if p and (p.Position-camPos).Magnitude <= S.AimRange and isVisible(char, p) then
                        local sc = pixelScore(p)
                        if sc < math.huge then table.insert(list, {plr=plr, part=p, score=sc, mode="players"}) end
                    end
                end
                if S.AimFPV then
                    local dp = findDronePart(char)
                    if dp and (dp.Position-camPos).Magnitude <= S.AimRange and isVisible(char, dp) then
                        local sc = pixelScore(dp)
                        if sc < math.huge then table.insert(list, {plr=plr, part=dp, score=sc, mode="fpv"}) end
                    end
                end
            end
        end
    end
    return list
end
local function findBest()
    local list = gatherCandidates()
    local best, bs = nil, math.huge
    for _, c in ipairs(list) do if c.score < bs then bs = c.score best = c end end
    return best
end
local function validateLock(lock)
    if not lock then return false end
    local plr = lock.plr
    if not isTargetable(plr) or not isEnemy(plr) then return false end
    local char = getChar(plr); if not char then return false end
    local p = (lock.mode=="fpv") and findDronePart(char) or getAimPart(char, "players")
    if not p then return false end
    if (p.Position - Camera.CFrame.Position).Magnitude > S.AimRange then return false end
    if not isVisible(char, p) then return false end
    lock.part = p
    return true
end
local function aimStep(dt)
    local active = S.AimEnabled and (not S.AimHold or HoldActive)
    if not (active and Camera) then LockedTarget = nil FOVCircle.Visible = false return end
    FOVCircle.Visible = true
    updateFOVSize()
    if LockedTarget and not validateLock(LockedTarget) then LockedTarget = nil end
    local now = tick()
    if not LockedTarget or (not S.AimSticky and now - LastSwitch > TARGET_SWITCH_CD) then
        local n = findBest()
        if n then LockedTarget = n LastSwitch = now end
    end
    if LockedTarget then
        local aimPos = predictPos(LockedTarget.part)
        if aimPos then
            local desired = CFrame.lookAt(Camera.CFrame.Position, aimPos)
            if S.AimSmooth >= 0.999 then Camera.CFrame = desired
            else
                local a = math.clamp(S.AimSmooth*(dt*60), 0.01, 1); a = a*(2-a)
                Camera.CFrame = Camera.CFrame:Lerp(desired, a)
            end
            if S.AimRotate then
                local myChar = LP.Character
                local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local myPos = hrp.Position
                    local look = Vector3.new(aimPos.X, myPos.Y, aimPos.Z)
                    local rot = CFrame.lookAt(myPos, look).Rotation
                    local a = math.clamp(S.AimSmooth*(dt*60), 0.01, 1)
                    hrp.CFrame = CFrame.new(myPos) * hrp.CFrame.Rotation:Lerp(rot, a)
                end
            end
        end
    end
end
