-- ==== LOOPS ====
RunService.Heartbeat:Connect(function()
    if killAuraActive then pcall(killAura) end
    if aimbotActive then pcall(aimbot) end
    if CFG.GodMode and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth end
    end
    if CFG.AutoFarm then
        for _, o in ipairs(workspace:GetChildren()) do
            if o.Name == "Coin" or o.Name:lower():find("coin") then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local v = (o.Position - hrp.Position).Magnitude
                    if v < 8 then hrp.CFrame = CFrame.new(o.Position) end
                end
            end
        end
    end
end)

