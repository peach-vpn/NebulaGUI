local opened = false
local busy = false

local function SetOpen(state)
    if busy or opened == state then return end
    busy = true
    opened = state
    
    if opened then
        Window.Visible = true
        local targetScale = Scale.Scale
        Scale.Scale = targetScale * 0.9
        Tween(Scale, { Scale = targetScale }, 0.25)
        task.delay(0.25, function() busy = false end)
    else
        Tween(Scale, { Scale = Scale.Scale * 0.9 }, 0.15)
        task.delay(0.15, function()
            Window.Visible = false
            busy = false
        end)
    end
end

Icon.Activated:Connect(function() SetOpen(not opened) end)
CloseBtn.Activated:Connect(function() SetOpen(false) end)

