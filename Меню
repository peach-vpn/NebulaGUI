local function ToggleRow(txt, initial, cb)
    local state = { v = initial }
    local b = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = C.card,
        Text = "",
        AutoButtonColor = false,
        Parent = Content
    })
    Corner(b, UDim.new(0, 7))
    Stroke(b, C.border, 1, 0.3)

    Create("TextLabel", {
        Size = UDim2.new(1, -56, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = txt,
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = b
    })

    local sw = Create("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -46, 0.5, -10),
        BackgroundColor3 = state.v and C.accent or Color3.fromRGB(45, 45, 60),
        BorderSizePixel = 0,
        Parent = b
    })
    Corner(sw, UDim.new(1, 0))

    local dot = Create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state.v and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.fromRGB(240, 240, 250),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = sw
    })
    Corner(dot, UDim.new(1, 0))

    local function apply(instant)
        local col = state.v and C.accent or Color3.fromRGB(45, 45, 60)
        local pos = state.v and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3)
        if instant then
            sw.BackgroundColor3 = col
            dot.Position = pos
        else
            Play(sw, TweenInfo.new(0.18), { BackgroundColor3 = col })
            Play(dot, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = pos })
        end
    end
    apply(true)

    b.MouseButton1Click:Connect(function()
        state.v = not state.v
        apply(false)
        if cb then pcall(cb, state.v) end
    end)
    return b
end

