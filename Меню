local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then obj[k] = v end
    end
    obj.Parent = parent
    return obj
end

local function Round(obj, size)
    return New("UICorner", { CornerRadius = UDim.new(0, size or 8) }, obj)
end

local function Outline(obj, color)
    return New("UIStroke", { 
        Color = color or C.border, 
        Transparency = 0.3, 
        Thickness = 1 
    }, obj)
end

local function Tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

