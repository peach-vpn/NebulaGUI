    }, Content)

    Padding(Page, 18)

    Create("UIListLayout", {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Page)

    local Title = Create("TextLabel", {
        Size = UDim2.new(1, -10, 0, 30),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        TextSize = 23,
