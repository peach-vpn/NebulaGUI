-- RESPONSIVE WINDOW

local function UpdateLayout()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local size = camera.ViewportSize
    local portrait = size.X < 600 or size.X < size.Y

    local width = portrait and 360 or 500
    local height = portrait and 410 or 320
    local sidebarWidth = portrait and 100 or 112

    Window.Size = UDim2.fromOffset(width, height)

    Sidebar.Size = UDim2.new(0, sidebarWidth, 1, -49)
    Content.Position = UDim2.fromOffset(sidebarWidth, 49)
    Content.Size = UDim2.new(1, -sidebarWidth, 1, -49)

    Scale.Scale = math.clamp(
        math.min(
            (size.X - 16) / width,
            (size.Y - 16) / height
        ),
        0.5,
        1
    )
end

UpdateLayout()

if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateLayout)
end

-- OPEN / CLOSE

local opened = false
local busy = false

local function SetOpen(state)
    if busy or opened == state then return end

    opened = state
    busy = true

    if opened then
        Window.Visible = true
        Scale.Scale = Scale.Scale * 0.92

        Tween(Scale, {
            Scale = math.min(
                1,
                math.min(
                    (workspace.CurrentCamera.ViewportSize.X - 16)
                        / Window.Size.X.Offset,
                    (workspace.CurrentCamera.ViewportSize.Y - 16)
                        / Window.Size.Y.Offset
                )
            )
        }, 0.2).Completed:Once(function()
            busy = false
        end)
    else
        local t = Tween(Scale, {
            Scale = Scale.Scale * 0.9
        }, 0.13)

        t.Completed:Once(function()
            Window.Visible = false
            UpdateLayout()
            busy = false
        end)
    end
end

Icon.Activated:Connect(function()
    if os.clock() - lastIconDrag < 0.25 then
        return
    end

    SetOpen(not opened)
end)

Close.Activated:Connect(function()
    SetOpen(false)
end)

UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        SetOpen(not opened)
    end
end)

