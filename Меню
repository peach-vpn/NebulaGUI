local function UpdateLayout()
    if not Camera then return end
    local size = Camera.ViewportSize
    local portrait = size.X < 600 or size.X < size.Y
    local width = portrait and 380 or 520
    local height = portrait and 420 or 340
    local sidebarWidth = portrait and 108 or 118

    Window.Size = UDim2.fromOffset(width, height)
    Sidebar.Size = UDim2.new(0, sidebarWidth, 1, -49)
    Content.Position = UDim2.fromOffset(sidebarWidth, 49)
    Content.Size = UDim2.new(1, -sidebarWidth, 1, -49)

    Scale.Scale = math.clamp(
        math.min((size.X - 16) / width, (size.Y - 16) / height),
        0.5, 1
    )
end

UpdateLayout()
bind(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateLayout))

--// OPEN/CLOSE
local opened = false
local busy = false

local function SetOpen(state)
    if busy or opened == state then return end
    opened = state
    busy = true
    if opened then
        Window.Visible = true
        Scale.Scale = Scale.Scale * 0.92
        Tween(Scale, { Scale = math.clamp(math.min((Camera.ViewportSize.X - 16) / Window.Size.X.Offset, (Camera.ViewportSize.Y - 16) / Window.Size.Y.Offset), 0.5, 1) }, 0.2).Completed:Once(function() busy = false end)
    else
        Tween(Scale, { Scale = Scale.Scale * 0.9 }, 0.13).Completed:Once(function()
            Window.Visible = false
            UpdateLayout()
            busy = false
        end)
    end
end

Icon.Activated:Connect(function()
    if os.clock() - lastIconDrag < 0.25 then return end
    SetOpen(not opened)
end)
Close.Activated:Connect(function() SetOpen(false) end)

bind(UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        SetOpen(not opened)
    end
end))

--// ROLE SYSTEM
local RoleCache = {}
local function cacheRole(n, r) if n and r then RoleCache[n] = tostring(r) end end
local function resetRoleCache() RoleCache = {} end
bind(LP.CharacterAdded:Connect(function() task.wait(1) resetRoleCache() end))

local function getRole(plr)
    if RoleCache[plr.Name] then return RoleCache[plr.Name] end
    local char = plr.Character
    if not char then return "Innocent" end
    local role = plr:GetAttribute("Role") or plr:GetAttribute("role")
    if role then cacheRole(plr.Name, role) return tostring(role) end
    role = char:GetAttribute("Role") or char:GetAttribute("role")
    if role then cacheRole(plr.Name, role) return tostring(role) end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("dagger") or n:find("sword") or n:find("blade") then cacheRole(plr.Name, "Murderer") return "Murderer" end
        if n:find("gun") or n:find("pistol") or n:find("revolver") then cacheRole(plr.Name, "Sheriff") return "Sheriff" end
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("dagger") then cacheRole(plr.Name, "Murderer") return "Murderer" end
                if n:find("gun") or n:find("pistol") then cacheRole(plr.Name, "Sheriff") return "Sheriff" end
            end
        end
    end
    return "Innocent"
end

