local opened = false
local function SetOpen(state)
    opened = state
    if opened then
        Window.Visible = true
        WindowScale.Scale = 0.9
        Play(WindowScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
    else
        Play(WindowScale, TweenInfo.new(0.15), { Scale = 0.9 })
        task.delay(0.15, function() Window.Visible = false end)
    end
end

Icon.MouseButton1Click:Connect(function() SetOpen(not opened) end)
CloseBtn.MouseButton1Click:Connect(function() SetOpen(false) end)

