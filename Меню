local function Card(parent, title, desc, height)
    local f = New("Frame", {
        Size = UDim2.new(1, -2, 0, height or (desc and 48 or 32)),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        ZIndex = 5
    }, parent)
    Round(f, 6)
    Outline(f)
    
    New("TextLabel", {
        Position = UDim2.fromOffset(8, desc and 5 or 0),
        Size = UDim2.new(1, -16, 0, desc and 15 or 32),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = C.text,
        TextSize = 11,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = desc and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        ZIndex = 6
    }, f)
    
    if desc then
        New("TextLabel", {
            Position = UDim2.fromOffset(8, 20),
            Size = UDim2.new(1, -16, 0, 24),
            BackgroundTransparency = 1,
            Text = desc,
            TextColor3 = C.muted,
            TextSize = 8,
            Font = Enum.Font.Gotham,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6
        }, f)
    end
    
    return f
end

local function Toggle(parent, title, desc, default, callback)
    local state = { v = default == true }
    local f = Card(parent, title, desc, desc and 48 or 32)
    
    local btn = New("TextButton", {
        Position = UDim2.new(1, -42, 0.5, -8),
        Size = UDim2.fromOffset(32, 16),
        BackgroundColor3 = state.v and C.accent or C.border,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7
    }, f)
    Round(btn, 8)
    
    local knob = New("Frame", {
        Position = UDim2.new(0, state.v and 17 or 2, 0.5, -6),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8
    }, btn)
    Round(knob, 6)
    
    local function update(instant)
        local col = state.v and C.accent or C.border
        local pos = UDim2.new(0, state.v and 17 or 2, 0.5, -6)
        if instant then
            btn.BackgroundColor3 = col
            knob.Position = pos
        else
            Tween(btn, { BackgroundColor3 = col }, 0.15)
            Tween(knob, { Position = pos }, 0.2)
        end
    end
    
    update(true)
    
    btn.Activated:Connect(function()
        state.v = not state.v
        update(false)
        if callback then pcall(callback, state.v) end
    end)
    
    return f
end

local function Slider(parent, title, min, max, default, callback)
    local f = Card(parent, title, nil, 42)
    local value = math.clamp(default, min, max)
    
    local valLbl = New("TextLabel", {
        Position = UDim2.new(1, -50, 0, 4),
        Size = UDim2.fromOffset(42, 14),
        BackgroundTransparency = 1,
        Text = tostring(math.floor(value)),
        TextColor3 = C.accent,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 6
    }, f)
    
    local track = New("Frame", {
        Position = UDim2.fromOffset(8, 24),
        Size = UDim2.new(1, -16, 0, 4),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0,
        ZIndex = 6
    }, f)
    Round(track, 2)
    
    local fill = New("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 7
    }, track)
    Round(fill, 2)
    
    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        Size = UDim2.fromOffset(10, 10),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8
    }, track)
    Round(knob, 5)
    Outline(knob, C.accent)
    
    local dragging = false
    
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + rel * (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(math.floor(value))
        if callback then pcall(callback, value) end
    end
    
    local hitbox = New("TextButton", {
        Size = UDim2.new(1, 20, 1, 16),
        Position = UDim2.fromOffset(-10, -8),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 10
    }, track)
    
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.1)
            update(input.Position.X)
        end
    end)
    
    bind(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end))
    
    bind(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Tween(knob, { Size = UDim2.fromOffset(10, 10) }, 0.1)
            end
        end
    end))
    
    return f
end

local function ActionButton(parent, title, desc, callback)
    local f = Card(parent, title, desc, desc and 48 or 32)
    
    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 7
    }, f)
    
    New("TextLabel", {
        Position = UDim2.new(1, -22, 0.5, -7),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        Text = "›",
        TextColor3 = C.accent,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        ZIndex = 8
    }, f)
    
    btn.Activated:Connect(function()
        Tween(f, { BackgroundColor3 = C.accent }, 0.08)
        task.delay(0.08, function() Tween(f, { BackgroundColor3 = C.card }, 0.15) end)
        if callback then pcall(callback) end
    end)
    
    return f
end

