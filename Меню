-- AUTO GUN PICKUP (фикс залипшего флага + возврат назад)
--========================================================--
local autoGunRunning = false

local function findNearestDroppedGun()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isGun(obj) and obj.Parent then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
            if handle then
                local d = (handle.Position - hrp.Position).Magnitude
                if d < bestD and d < 800 then bestD = d best = obj end
            end
        end
    end
    return best
end

local function autoGunPickup()
    if autoGunRunning then return end
    autoGunRunning = true

    local ok, err = pcall(function()
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local gun = findNearestDroppedGun()
        if not gun then return end

        local handle = gun:FindFirstChild("Handle") or gun:FindFirstChildWhichIsA("BasePart", true)
        if not handle then return end

        local saved = hrp.CFrame
        local savedVel = hrp.AssemblyLinearVelocity
        local savedSubject = Camera and Camera.CameraSubject

        -- телепорт к пистолету
        pcall(function() hrp.CFrame = CFrame.new(handle.Position + Vector3.new(0, 3, 0)) end)

        -- ждём пока подберётся
        for _ = 1, 30 do
            task.wait(0.1)
            local c = LP.Character
            local tool = c and c:FindFirstChildOfClass("Tool")
            if tool and isGun(tool) then break end
        end

        task.wait(S.AutoGunReturnDelay)

        -- возврат на исходное место
        pcall(function()
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then
                h.CFrame = saved
                h.AssemblyLinearVelocity = savedVel
            end
        end)
    end)

    if not ok then
        -- аварийный фикс если что-то пошло не так
        pcall(function()
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then h.AssemblyLinearVelocity = Vector3.zero end
        end)
    end

    autoGunRunning = false
end

