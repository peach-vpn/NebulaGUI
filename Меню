function applySkin(name)
    local char = LP.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then print("[AD] Нет Tool в руках") return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Parent = handle
    end
    if not S.OriginalMesh then
        S.OriginalMesh = mesh.MeshId
        S.OriginalTexture = mesh.TextureId
    end
    if name == "Standard" then
        if S.OriginalMesh then mesh.MeshId = S.OriginalMesh end
        if S.OriginalTexture then mesh.TextureId = S.OriginalTexture end
        S.CurrentSkin = "Standard"
        return
    end
    local data = SKIN_DATA[name]
    if not data then return end
    if data.Mesh then mesh.MeshId = data.Mesh end
    if data.Texture then mesh.TextureId = data.Texture end
    S.CurrentSkin = name
    print("[AD] Скин: " .. name .. " (только у тебя)")
end

