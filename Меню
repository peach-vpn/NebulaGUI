    if hooks[h] then return end
    hooks[h] = true
    bind(h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if S.SpeedBoost and h.WalkSpeed ~= S.SpeedValue then h.WalkSpeed = S.SpeedValue end
    end))
    bind(h:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if S.JumpBoost and h.JumpPower ~= S.JumpValue then h.JumpPower = S.JumpValue end
    end))
end

