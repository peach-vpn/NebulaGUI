local function getMyTool()
    local char = LP.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function saveOriginalSkin(tool)
    if S.OriginalMesh then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        S.OriginalMesh = mesh.MeshId
        S.OriginalTexture = mesh.TextureId
    end
end

local function applySkin(skinName)
    local tool = getMyTool()
    if not tool then print("[AD] Нет Tool в руках") return end
