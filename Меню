local function SelectTab(name)
    CurrentTab = name

    for tabName, tab in pairs(Tabs) do
        local active = tabName == name

        Tween(tab.Button, {
            BackgroundColor3 = active and Theme.Card or Theme.Sidebar
        }, 0.15)

        tab.Accent.Visible = active
        tab.Label.TextColor3 = active and Theme.Text or Theme.Muted

        Pages[tabName].Visible = active
        Pages[tabName].CanvasPosition = Vector2.zero
    end
end

