local autoGunRunning = false
local function autoGunOneShot()
    if autoGunRunning then return end
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local bestGun, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isGun(obj) then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local d = (handle.Position - myHrp.Position).Magnitude
                if d < bestDist and d < 800 then bestDist = d; bestGun = handle end
            end
        end
    end
    if not bestGun then print("[AD] Пистолет не найден") return end
    autoGunRunning = true
    task.spawn(function()
        local savedPos = myHrp.CFrame
        pcall(function() myHrp.CFrame = CFrame.new(bestGun.Position + Vector3.new(0, 2, 0)) end)
        for i = 1, 30 do
            task.wait(0.1)
            local curChar = LP.Character
            if curChar and curChar:FindFirstChildOfClass("Tool") then break end
        end
        task.wait(0.3)
        pcall(function()
            local curChar = LP.Character
            local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
            if curHrp then curHrp.CFrame = savedPos end
        end)
        autoGunRunning = false
    end)
end

