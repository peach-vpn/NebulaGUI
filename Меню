        S.AntiFling = v
        if v then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
                _G.__AntiFlingBV = bv
            end
        else
            if _G.__AntiFlingBV then pcall(function() _G.__AntiFlingBV:Destroy() end); _G.__AntiFlingBV = nil end
        end
    end)
    Section("ПРЫЖОК")
    Toggle("Infinite Jump", S.InfiniteJump, function(v) S.InfiniteJump = v end)
    PageFade()
end

