-- MAIN RENDER
--========================================================--
local accum = 0
local UPDATE_STEP = 1 / 20

bind(RunService.RenderStepped:Connect(function(dt)
    if S.AimAuto and isSheriff() then
        local target = findMurderer()
        if target then
            local char = getCharacter(target)
            local head = char and char:FindFirstChild("Head")
            if head then
                local desired = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                local baseSmooth = S.AimFast and 0.98 or S.AimSmooth
                if baseSmooth >= 0.99 then
                    Camera.CFrame = desired
                else
                    local sm = math.clamp(baseSmooth * (dt * 60), 0.05, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(desired, sm)
                end
            end
        end
    end

    accum = accum + dt
    if accum >= UPDATE_STEP then
        accum = 0
        if S.ESPMurderer or S.ESPSheriff or S.ESPHero or S.ESPInnocent then
            for plr, d in pairs(ESPData) do
                local role = getRole(plr)
                local char = getCharacter(plr)
                local showRole =
                    (role == "Murderer" and S.ESPMurderer) or
                    (role == "Sheriff" and S.ESPSheriff) or
                    (role == "Hero" and S.ESPHero) or
                    (role ~= "Murderer" and role ~= "Sheriff" and role ~= "Hero" and S.ESPInnocent)
                if char and isAlive(char) and showRole then
                    local root = getRoot(char)
                    local head = getHead(char)
                    local camPos = Camera.CFrame.Position
                    if root then
                        local distance = (root.Position - camPos).Magnitude
                        if distance > S.ESPMaxDistance then
                            d.Info.Enabled = false; d.Highlight.Enabled = false
                        else
                            d.Info.Enabled = true; d.Info.Adornee = head or root; d.Info.MaxDistance = S.ESPMaxDistance
                            local color = role == "Murderer" and COLOR_MURDERER or role == "Sheriff" and COLOR_SHERIFF or role == "Hero" and COLOR_HERO or COLOR_INNOCENT
                            d.Name.Text = plr.Name; d.Name.TextColor3 = color
                            d.Role.Text = role == "Murderer" and "УБИЙЦА" or role == "Sheriff" and "ШЕРИФ" or role == "Hero" and "ГЕРОЙ" or "МИРНЫЙ"
                            d.Role.TextColor3 = color
                            d.Dist.Text = string.format("%d м", math.floor(distance))
                            d.Dist.Visible = S.ESPDistance
                            d.Name.Visible = S.ESPName
                            d.Highlight.Enabled = S.ESPHighlight
                            d.Highlight.FillColor = color
                            d.Highlight.Adornee = char
                        end
                    end
                else
                    d.Info.Enabled = false; d.Highlight.Enabled = false
                end
            end
        else
            for _, d in pairs(ESPData) do d.Info.Enabled = false; d.Highlight.Enabled = false end
        end
    end
end))

