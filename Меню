local function SliderRow(txt, initial, min, max, cb)
    local frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        Parent = Content
    })
    Corner(frame, UDim.new(0, 7))
