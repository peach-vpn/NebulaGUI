-- TABS REGISTRY
--========================================================--
local Tabs = {}   -- [name] = { Button, Bar, Icon, Label }
local Pages = {}  -- [name] = render function

local function ClearContent()
    for _, v in ipairs(Content:GetChildren()) do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then v:Destroy() end
    end
end

local function SelectTab(name)
    for tabName, item in pairs(Tabs) do
        local selected = tabName == name
        Play(item.Button, TweenInfo.new(0.15), {
            BackgroundColor3 = selected and C.card or C.panel,
        })
        item.Bar.Visible = selected
        item.Label.TextColor3 = selected and C.text or C.muted
        item.Icon.TextColor3 = selected and C.accent2 or C.muted
    end
    ClearContent()
    Content.CanvasPosition = Vector2.new(0, 0)
    if Pages[name] then pcall(Pages[name]) end
end

