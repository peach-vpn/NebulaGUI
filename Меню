--// TOGGLE
local function Toggle(parent, title, description, default, callback)
    local frame = Card(parent, title, description, 48)
    local enabled = default == true

    local button = New("TextButton", {
        Position=UDim2.new(1, -43, 0.5, -9), Size=UDim2.fromOffset(33, 18),
        BackgroundColor3 = enabled and C.accent or C.border, Text="",
        AutoButtonColor=false, ZIndex=7
    }, frame)
    Round(button, 10)

    local knob = New("Frame", {
        Position=UDim2.new(0, enabled and 17 or 2, 0.5, -7),
        Size=UDim2.fromOffset(14, 14),
        BackgroundColor3=Color3.new(1, 1, 1), ZIndex=8
    }, button)
    Round(knob, 7)

    local function set(v)
        enabled = v
        Tween(button, { BackgroundColor3 = enabled and C.accent or C.border })
        Tween(knob, { Position = UDim2.new(0, enabled and 17 or 2, 0.5, -7) })
        if callback then pcall(callback, enabled) end
    end

    button.Activated:Connect(function() set(not enabled) end)
    return frame, { get = function() return enabled end, set = set }
end

