local function Number(parent, title, initial, min, max, callback)
    local frame = New("Frame", {
        Size=UDim2.new(1, -2, 0, 36), BackgroundColor3=C.card, BorderSizePixel=0, ZIndex=5
    }, parent)
    Round(frame, 8)
