            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6
        }, f)
    end
    return f
end

local function Toggle(parent, title, desc, default, callback)
    local state = { v = default == true }
    local f = Card(parent, title, desc, desc and 50 or 36)
    
    local btn = New("TextButton", {
        Position = UDim2.new(1, -45, 0.5, -9),
        Size = UDim2.fromOffset(34, 18),
        BackgroundColor3 = state.v and C.accent or C.border,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7
    }, f)
    Round(btn, 9)
    
    local knob = New("Frame", {
        Position = UDim2.new(0, state.v and 18 or 2, 0.5, -7),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8
    }, btn)
    Round(knob, 7)
    
    local function update(instant)
        local col = state.v and C.accent or C.border
        local pos = UDim2.new(0, state.v and 18 or 2, 0.5, -7)
        if instant then
            btn.BackgroundColor3 = col
            knob.Position = pos
        else
            Tween(btn, { BackgroundColor3 = col })
            Tween(knob, { Position = pos })
        end
    end
    
    update(true)
    
    btn.Activated:Connect(function()
        state.v = not state.v
        update(false)
        if callback then pcall(callback, state.v) end
    end)
    
    return f, state
end

local function Slider(parent, title, min, max, default, callback)
    local f = Card(parent, title, nil, 45)
    local value = math.clamp(default, min, max)
    
    local lbl = New("TextLabel", {
        Position = UDim2.fromOffset(10, 4),
        Size = UDim2.new(0.5, -10, 0, 16),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = C.text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 6
    }, f)
    
    local valLbl = New("TextLabel", {
        Position = UDim2.new(0.5, 0, 0, 4),
        Size = UDim2.new(0.5, -10, 0, 16),
        BackgroundTransparency = 1,
        Text = tostring(math.floor(value)),
        TextColor3 = C.accent,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 6
    }, f)
    
    local track = New("Frame", {
        Position = UDim2.fromOffset(10, 26),
        Size = UDim2.new(1, -20, 0, 4),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0,
        ZIndex = 6
    }, f)
    Round(track, 2)
    
    local fill = New("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 7
    }, track)
    Round(fill, 2)
    
    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8
    }, track)
    Round(knob, 6)
    New("UIStroke", { Color = C.accent, Thickness = 2 }, knob)
    
    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + rel * (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(math.floor(value))
        if callback then pcall(callback, value) end
    end
    
    local hitbox = New("TextButton", {
        Size = UDim2.new(1, 10, 1, 20),
        Position = UDim2.fromOffset(-5, -10),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 9
    }, track)
    
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Tween(knob, { Size = UDim2.fromOffset(16, 16) })
            update(input.Position.X)
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Tween(knob, { Size = UDim2.fromOffset(12, 12) })
            end
        end
    end)
    
    return f
end

local function Button(parent, title, desc, callback)
    local f = Card(parent, title, desc, desc and 50 or 36)
    local btn = New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 7
    }, f)
    
    New("TextLabel", {
        Position = UDim2.new(1, -25, 0.5, -8),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        Text = "›",
        TextColor3 = C.accent,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        ZIndex = 8
    }, f)
    
    btn.Activated:Connect(function()
        Tween(f, { BackgroundColor3 = C.accent }, 0.1)
        task.delay(0.1, function() Tween(f, { BackgroundColor3 = C.card }, 0.15) end)
        if callback then pcall(callback) end
    end)
    
    return f
end

