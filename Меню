local function CreateSlider(parent, title, description, min, max, default)
    local Card = CreateCard(parent, title, description)
    Card.Size = UDim2.new(1, -5, 0, 94)

    local value = default or min

    local ValueLabel = Create("TextLabel", {
        Position = UDim2.new(1, -75, 0, 10),
        Size = UDim2.fromOffset(60, 22),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = Theme.Accent,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right
    }, Card)

    local Track = Create("TextButton", {
        Position = UDim2.new(0, 13, 1, -23),
        Size = UDim2.new(1, -26, 0, 6),
        BackgroundColor3 = Color3.fromRGB(50, 48, 66),
        Text = "",
        AutoButtonColor = false
    }, Card)

    Corner(Track, 5)

    local ratio = (value - min) / math.max(1, max - min)

    local Fill = Create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0
    }, Track)

    Corner(Fill, 5)

    local dragging = false

    local function SetValue(x)
        local ratioNow = math.clamp(
            (x - Track.AbsolutePosition.X) /
            math.max(1, Track.AbsoluteSize.X),
            0,
            1
        )

        value = math.floor(min + (max - min) * ratioNow)

        ValueLabel.Text = tostring(value)

        Animate(Fill, {
            Size = UDim2.new(ratioNow, 0, 1, 0)
        }, 0.05)

        -- UI only: use value in your own callback if needed.
    end

    Track.Activated:Connect(function()
        SetValue(UserInputService:GetMouseLocation().X)
    end)

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            SetValue(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetValue(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return Card
end

