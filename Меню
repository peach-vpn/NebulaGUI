--========================================================--
-- GUI HELPERS
--========================================================--

local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function Round(obj, size)
    return New("UICorner", { CornerRadius = UDim.new(0, size or 8) }, obj)
end

local function Outline(obj)
    return New("UIStroke", { Color = C.border, Transparency = 0.2, Thickness = 1 }, obj)
end

local function Tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

