                if thrp then
                    local d = (thrp.Position - hrp.Position).Magnitude
                    if d < bestD then bestD = d best = thrp end
                end
            end
        end
        if best then pcall(function() hrp.CFrame = best.CFrame tool:Activate() end) end
    end

    if S.KnifeThrow and isKnife and hrp then
        local now = tick()
        if not _G.__KnifeThrowLast or now - _G.__KnifeThrowLast > S.KnifeThrowCooldown then
