local accum = 0
local STEP = 1/20

bind(RunService.RenderStepped:Connect(function(dt)
    if S.AimAuto and isSheriff() then
        local target = findMurderer()
        if target then
            local char = getChar(target)
            local head = char and char:FindFirstChild("Head")
            if head then
                local desired = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                local base = S.AimFast and 0.98 or S.AimSmooth
                if base >= 0.99 then
                    Camera.CFrame = desired
                else
                    local sm = math.clamp(base * (dt * 60), 0.05, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(desired, sm)
                end
            end
        end
    end

    accum = accum + dt
    if accum >= STEP then
        accum = 0
        for plr, d in pairs(ESPData) do
            local role = getRole(plr)
            local char = getChar(plr)
            local show =
                (role == "Murderer" and S.ESPMurderer) or
                (role == "Sheriff" and S.ESPSheriff) or
                (role == "Hero" and S.ESPHero) or
                (role ~= "Murderer" and role ~= "Sheriff" and role ~= "Hero" and S.ESPInnocent)
            if char and isAlive(char) and show then
                local root = getRoot(char)
                local head = getHead(char)
                local camPos = Camera.CFrame.Position
                if root then
                    local dist = (root.Position - camPos).Magnitude
                    if dist > S.ESPMaxDistance then
                        d.Info.Enabled=false d.Highlight.Enabled=false
                    else
                        d.Info.Enabled=true
                        d.Info.Adornee = head or root
                        d.Info.MaxDistance = S.ESPMaxDistance
                        local col = COLOR[role] or COLOR.Innocent
                        d.Name.Text = plr.Name
                        d.Name.TextColor3 = col
                        d.Role.Text = role == "Murderer" and "УБИЙЦА" or role == "Sheriff" and "ШЕРИФ" or role == "Hero" and "ГЕРОЙ" or "МИРНЫЙ"
                        d.Role.TextColor3 = col
                        d.Dist.Text = string.format("%d м", math.floor(dist))
                        d.Dist.Visible = S.ESPDistance
                        d.Name.Visible = S.ESPName
                        d.Highlight.Enabled = S.ESPHighlight
                        d.Highlight.FillColor = col
                        d.Highlight.Adornee = char
                    end
                end
            else
                d.Info.Enabled=false d.Highlight.Enabled=false
            end
        end
    end
end))

--// SPEED / JUMP / NOCLIP
local hooks = {}
local function hookHumanoid(h)
    if hooks[h] then return end
    hooks[h] = true
    bind(h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if S.SpeedBoost and h.WalkSpeed ~= S.SpeedValue then h.WalkSpeed = S.SpeedValue end
    end))
    bind(h:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if S.JumpBoost and h.JumpPower ~= S.JumpValue then h.JumpPower = S.JumpValue end
    end))
end

bind(RunService.Stepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hookHumanoid(hum)
    if S.SpeedBoost then
        if hum.WalkSpeed ~= S.SpeedValue then hum.WalkSpeed = S.SpeedValue end
    else
        if hum.WalkSpeed ~= 16 then hum.WalkSpeed = 16 end
    end
    hum.UseJumpPower = true
    if S.JumpBoost then
        if hum.JumpPower ~= S.JumpValue then hum.JumpPower = S.JumpValue end
    else
        if hum.JumpPower ~= 50 then hum.JumpPower = 50 end
    end
    if S.NoClip then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then pcall(function() d.CanCollide=false end) end
        end
    end
end))

