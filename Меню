local RoleCache = {}

local function getRole(plr)
    if RoleCache[plr.Name] then return RoleCache[plr.Name] end
    local char = plr.Character
    if not char then return "Innocent" end
    
    local role = plr:GetAttribute("Role") or char:GetAttribute("Role")
    if role then RoleCache[plr.Name] = tostring(role) return tostring(role) end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("dagger") then RoleCache[plr.Name] = "Murderer" return "Murderer" end
        if n:find("gun") or n:find("pistol") or n:find("revolver") then RoleCache[plr.Name] = "Sheriff" return "Sheriff" end
    end
    
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("dagger") then RoleCache[plr.Name] = "Murderer" return "Murderer" end
                if n:find("gun") or n:find("pistol") then RoleCache[plr.Name] = "Sheriff" return "Sheriff" end
            end
        end
    end
    
    return "Innocent"
end

