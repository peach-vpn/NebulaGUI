                if thum and thum.Health > 0 and thrp then
                    local d = (thrp.Position - hrp.Position).Magnitude
                    if d <= S.KillAuraRange then pcall(function() hrp.CFrame = thrp.CFrame tool:Activate() end) end
                end
            end
        end
