local RoleCache = {}
local RoleCacheTime = {}
local ROLE_CACHE_TTL = 3

local function cacheRole(n, r)
    if n and r then
        RoleCache[n] = tostring(r)
        RoleCacheTime[n] = tick()
    end
end
local function resetRoleCache() RoleCache = {} RoleCacheTime = {} end
local function resetRoleFor(plr)
    RoleCache[plr.Name] = nil
    RoleCacheTime[plr.Name] = nil
end

bind(LP.CharacterAdded:Connect(function() task.wait(1) resetRoleCache() end))

local function getRole(plr)
    local cached = RoleCache[plr.Name]
    if cached and (tick() - (RoleCacheTime[plr.Name] or 0)) < ROLE_CACHE_TTL then
        return cached
    end
    local char = plr.Character
    if not char then return "Innocent" end
    local role = plr:GetAttribute("Role") or plr:GetAttribute("role")
    if role then cacheRole(plr.Name, role) return tostring(role) end
    role = char:GetAttribute("Role") or char:GetAttribute("role")
    if role then cacheRole(plr.Name, role) return tostring(role) end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("dagger") or n:find("sword") or n:find("blade") then
            cacheRole(plr.Name, "Murderer") return "Murderer"
        end
        if n:find("gun") or n:find("pistol") or n:find("revolver") then
            cacheRole(plr.Name, "Sheriff") return "Sheriff"
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("dagger") then cacheRole(plr.Name, "Murderer") return "Murderer" end
                if n:find("gun") or n:find("pistol") then cacheRole(plr.Name, "Sheriff") return "Sheriff" end
            end
        end
    end
    return "Innocent"
end

-- reset role cache when someone respawns
local function hookRoleReset(plr)
    if plr == LP then return end
    bind(plr.CharacterAdded:Connect(function()
        task.wait(0.4)
        resetRoleFor(plr)
    end))
    bind(plr.CharacterRemoving:Connect(function()
        resetRoleFor(plr)
    end))
    -- role attribute changes
    local ok = pcall(function()
        bind(plr:GetAttributeChangedSignal("Role"):Connect(function()
            resetRoleFor(plr)
        end))
        bind(plr:GetAttributeChangedSignal("role"):Connect(function()
            resetRoleFor(plr)
        end))
    end)
end

