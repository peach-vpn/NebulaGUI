--// DRAG
local lastIconDrag = 0

local function MakeDraggable(handle, target, isIcon)
    local active=false, startPos, startTargetPos, moved=false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            startPos = input.Position
            startTargetPos = target.Position
            moved = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not active then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startPos
            if delta.Magnitude > 4 then
                moved = true
                if isIcon then lastIconDrag = os.clock() end
            end
            if moved then
                target.Position = UDim2.new(startTargetPos.X.Scale, startTargetPos.X.Offset + delta.X, startTargetPos.Y.Scale, startTargetPos.Y.Offset + delta.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)
end

