    local Switch = Create("TextButton", {
        Position = UDim2.new(1, -57, 0.5, -12),
        Size = UDim2.fromOffset(43, 24),
        BackgroundColor3 = enabled and Theme.Accent or Theme.Border,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 7
    }, Card)

    Round(Switch, 12)

    local Knob = Create("Frame", {
        Position = UDim2.new(0, enabled and 22 or 3, 0.5, -9),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 8
    }, Switch)

    Round(Knob, 9)

    Switch.Activated:Connect(function()
        enabled = not enabled

        Tween(Switch, {
            BackgroundColor3 = enabled and Theme.Accent or Theme.Border
        }, 0.16)

        Tween(Knob, {
            Position = UDim2.new(0, enabled and 22 or 3, 0.5, -9)
        }, 0.16)
    end)

    return Card
end

