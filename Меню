local RoleCache = {}

local function getRole(plr)
    if RoleCache[plr.Name] then return RoleCache[plr.Name] end
    
    local char = plr.Character
    if not char then return "Innocent" end
    
    -- Check attributes first
    local role = plr:GetAttribute("Role") or char:GetAttribute("Role")
    if role then
        RoleCache[plr.Name] = tostring(role)
        return tostring(role)
    end
    
    -- Check tools
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("knife") or n:find("dagger") or n:find("sword") or n:find("blade") then
            RoleCache[plr.Name] = "Murderer"
            return "Murderer"
        end
        if n:find("gun") or n:find("pistol") or n:find("revolver") then
            RoleCache[plr.Name] = "Sheriff"
            return "Sheriff"
        end
    end
    
    -- Check backpack
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("knife") or n:find("dagger") then
                    RoleCache[plr.Name] = "Murderer"
                    return "Murderer"
                end
                if n:find("gun") or n:find("pistol") then
                    RoleCache[plr.Name] = "Sheriff"
                    return "Sheriff"
                end
            end
        end
    end
    
    return "Innocent"
end

