function MurdererPage()
    Clear()
    Title.Text = "Убийца"
    Subtitle.Text = "Только с ножом"
    Section("ОСНОВНОЕ")
    Toggle("Kill Aura", S.KillAura, function(v) S.KillAura = v end)
    Slider("Радиус ауры", S.KillAuraRange, 5, 50, function(v) S.KillAuraRange = v end)
    Toggle("Авто-убийство ближайшего", S.AutoKillNearest, function(v) S.AutoKillNearest = v end)
    Section("КИДАНИЕ НОЖА")
    Toggle("Авто-кидание", S.KnifeThrow, function(v) S.KnifeThrow = v end)
    Slider("Дистанция", S.KnifeThrowRange, 10, 200, function(v) S.KnifeThrowRange = v end)
    Slider("Задержка x10", S.KnifeThrowCooldown * 10, 1, 30, function(v) S.KnifeThrowCooldown = v / 10 end)
    Section("РУЧНОЕ")
    Button("Кинуть нож", function()
        local char = LP.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return end
        pcall(function() tool:Activate() end)
    end)
    Button("Убить ближайшего", function()
        local char = LP.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool or not myHrp then return end
        local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local tchar = plr.Character
                local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
                if thrp then
                    local d = (thrp.Position - myHrp.Position).Magnitude
                    if d < bestD then bestD = d; best = thrp end
                end
            end
        end
        if best then pcall(function() myHrp.CFrame = best.CFrame; tool:Activate() end) end
    end)
    PageFade()
end

