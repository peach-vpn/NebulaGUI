--// HELPERS
local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function Round(obj, size) New("UICorner", { CornerRadius = UDim.new(0, size or 9) }, obj) end
local function Outline(obj, color, transparency)
    New("UIStroke", { Color = color or C.border, Transparency = transparency or 0.2, Thickness = 1 }, obj)
end
local function Tween(obj, props, duration)
    local t = TweenService:Create(obj, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

