local function SelectTab(name)
    for tabName, item in pairs(Tabs) do
        local selected = tabName == name
        Tween(item.Button, { BackgroundColor3 = selected and C.card or C.panel }, 0.15)
        item.Bar.Visible = selected
        item.Label.TextColor3 = selected and C.text or C.muted
        item.Icon.TextColor3 = selected and C.accent or C.muted
        Pages[tabName].Visible = selected
        Pages[tabName].CanvasPosition = Vector2.zero
    end
end

