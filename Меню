        BackgroundTransparency=1, Text=title, TextColor3=C.text, TextSize=11,
        Font=Enum.Font.GothamSemibold, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6
    }, frame)
    local box = New("TextBox", {
        Position=UDim2.new(1, -58, 0.5, -10), Size=UDim2.fromOffset(48, 20),
        BackgroundColor3=C.bg, Text=tostring(initial), TextColor3=C.accent,
        TextSize=11, Font=Enum.Font.GothamBold, ClearTextOnFocus=false, ZIndex=6
    }, frame)
    Round(box, 5)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if not n then box.Text = tostring(initial) return end
        n = math.clamp(n, min, max)
        box.Text = tostring(n)
        if callback then pcall(callback, n) end
    end)
    return frame
end

--// SLIDER
local function Slider(parent, title, initial, min, max, callback)
    local frame = New("Frame", {
        Size=UDim2.new(1, -2, 0, 48), BackgroundColor3=C.card, BorderSizePixel=0, ZIndex=5
    }, parent)
    Round(frame, 8)
    Outline(frame)
    New("TextLabel", {
        Position=UDim2.fromOffset(10, 4), Size=UDim2.new(0.6, -10, 0, 18),
        BackgroundTransparency=1, Text=title, TextColor3=C.text, TextSize=11,
        Font=Enum.Font.GothamSemibold, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6
    }, frame)
    local valueLabel = New("TextLabel", {
        Position=UDim2.new(0.6, 0, 0, 4), Size=UDim2.new(0.4, -10, 0, 18),
        BackgroundTransparency=1, Text=string.format("%d/%d", math.floor(initial), max),
        TextColor3=C.accent, TextSize=11, Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Right, ZIndex=6
    }, frame)
    local track = New("Frame", {
        Position=UDim2.new(0, 10, 0, 30), Size=UDim2.new(1, -20, 0, 6),
        BackgroundColor3=Color3.fromRGB(40, 40, 55), BorderSizePixel=0, ZIndex=6
    }, frame)
    Round(track, 3)
    local fill = New("Frame", { Size=UDim2.new(0, 0, 1, 0), BackgroundColor3=C.accent, BorderSizePixel=0, ZIndex=7 }, track)
    Round(fill, 3)
    local knob = New("Frame", {
        Size=UDim2.fromOffset(14, 14), AnchorPoint=Vector2.new(0.5, 0.5),
        Position=UDim2.new(0, 0, 0.5, 0), BackgroundColor3=Color3.fromRGB(240, 244, 255),
        BorderSizePixel=0, ZIndex=8
    }, track)
    Round(knob, 7)
    New("UIStroke", { Color=C.accent, Thickness=2 }, knob)

    local hitbox = New("TextButton", {
        Size=UDim2.new(1, 0, 0, 24), Position=UDim2.new(0, 0, 0, -9),
        BackgroundTransparency=1, Text="", AutoButtonColor=false, ZIndex=9
    }, track)

    local value = math.clamp(initial, min, max)
    local dragging = false

    local function update(animate)
        local ratio = (value - min) / math.max(max - min, 1)
        local tgtFill = UDim2.new(ratio, 0, 1, 0)
        local tgtKnob = UDim2.new(ratio, 0, 0.5, 0)
        if animate then
            Tween(fill, { Size = tgtFill }, 0.1)
            Tween(knob, { Position = tgtKnob }, 0.1)
        else
            fill.Size = tgtFill
            knob.Position = tgtKnob
        end
        valueLabel.Text = string.format("%d/%d", math.floor(value), max)
    end

    local function setFromX(x)
        local abs = track.AbsolutePosition
        local size = track.AbsoluteSize.X
        if size <= 0 then return end
        local rel = math.clamp((x - abs.X) / size, 0, 1)
        value = min + rel * (max - min)
        update(false)
        if callback then pcall(callback, value) end
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.15)
            setFromX(input.Position.X)
        end
    end)
    bind(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end))
    bind(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15)
            end
        end
    end))
    update(true)
    return frame
end

