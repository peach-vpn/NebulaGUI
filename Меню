--========================================================--
-- SKIN FUNCTIONS
--========================================================--
local function getMyTool()
    local char = LP.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function saveOriginalSkin(tool)
    if S.OriginalMesh then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        S.OriginalMesh = mesh.MeshId
        S.OriginalTexture = mesh.TextureId
    end
end

local function applySkin(skinName)
    local tool = getMyTool()
    if not tool then print("[AD] Нет Tool в руках") return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    saveOriginalSkin(tool)

    if skinName == "Standard" then
        local mesh = handle:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            if S.OriginalMesh then mesh.MeshId = S.OriginalMesh end
            if S.OriginalTexture then mesh.TextureId = S.OriginalTexture end
        end
        S.CurrentSkin = "Standard"
        return
    end

    local skin = SKINS[skinName]
    if not skin then return end
    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Parent = handle
    end
    if skin.Mesh then mesh.MeshId = skin.Mesh end
    if skin.Texture then mesh.TextureId = skin.Texture end
    S.CurrentSkin = skinName
end

