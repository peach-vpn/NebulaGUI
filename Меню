local autoGunRunning = false
local function autoGunOneShot()
    if autoGunRunning then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local best, bestD = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isGun(obj) then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local d = (handle.Position - hrp.Position).Magnitude
                if d < bestD and d < 800 then bestD = d best = handle end
            end
        end
    end
    if not best then return end
    autoGunRunning = true
    task.spawn(function()
        local saved = hrp.CFrame
        pcall(function() hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, 2, 0)) end)
        for _ = 1, 30 do
            task.wait(0.1)
            local c = LP.Character
            if c and c:FindFirstChildOfClass("Tool") then break end
        end
        task.wait(0.3)
        pcall(function()
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then h.CFrame = saved end
        end)
        autoGunRunning = false
    end)
end

