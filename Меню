local function isSheriff()
    local char = LP.Character
    if not char then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("gun") or n:find("pistol") or n:find("revolver") then return true end
    end
    return false
end

local function findMurderer()
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = Camera.CFrame.Position
    local best, bestScore = nil, math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and getRole(plr) == "Murderer" then
            local char = plr.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local head = char:FindFirstChild("Head")
                if head then
                    local dist = (head.Position - camPos).Magnitude
                    if dist <= S.AimRange then
                        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen and pos.Z > 0 then
                            local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if pd <= S.AimFOV and pd < bestScore then
                                local visible = true
                                if S.AimWall then
                                    local params = RaycastParams.new()
                                    params.FilterType = Enum.RaycastFilterType.Exclude
                                    params.FilterDescendantsInstances = { LP.Character, Camera }
                                    local hit = workspace:Raycast(camPos, head.Position - camPos, params)
                                    visible = not hit or hit.Instance:IsDescendantOf(char)
                                end
                                if visible then best = plr bestScore = pd end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

