function applySkin(skinName)
    local char = LP.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    
    -- Save original
    if not OriginalMesh then
        local mesh = handle:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            OriginalMesh = mesh.MeshId
            OriginalTexture = mesh.TextureId
        end
    end
    
    if skinName == "Standard" then
        local mesh = handle:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            if OriginalMesh then mesh.MeshId = OriginalMesh end
            if OriginalTexture then mesh.TextureId = OriginalTexture end
        end
        S.CurrentSkin = "Standard"
        return
    end
    
    local skin = SKINS[skinName]
    if not skin then return end
    
    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.Parent = handle
    end
    if skin.Mesh then mesh.MeshId = skin.Mesh end
    if skin.Texture then mesh.TextureId = skin.Texture end
    S.CurrentSkin = skinName
end

