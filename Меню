local autoGunRunning = false
function autoGunOneShot()
    if autoGunRunning then return end
    
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local bestGun, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isGun(obj) then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                local d = (handle.Position - hrp.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestGun = handle
                end
            end
        end
    end
    
    if not bestGun then return end
    autoGunRunning = true
    
    task.spawn(function()
        local savedPos = hrp.CFrame
        pcall(function() hrp.CFrame = CFrame.new(bestGun.Position + Vector3.new(0, 2, 0)) end)
        
        for i = 1, 30 do
            task.wait(0.1)
            if char and char:FindFirstChildOfClass("Tool") then break end
        end
        
        task.wait(0.3)
        pcall(function() hrp.CFrame = savedPos end)
        autoGunRunning = false
    end)
end

