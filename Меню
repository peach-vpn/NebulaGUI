        local target = Vector3.zero
        if move.Magnitude > 0.05 then
            target = move.Unit * S.FlySpeed
            local fd = move:Dot(Vector3.new(look.X, 0, look.Z).Unit)
            if fd > 0.1 then target = target + Vector3.new(0, look.Y * S.FlySpeed * fd, 0) end
        end
        flyVel = flyVel:Lerp(target, math.clamp(dt * 12, 0, 1))
        flyBV.Velocity = flyVel
        flyBG.CFrame = Camera.CFrame
    end
    
    -- Kill Aura
    if S.KillAura and isKnife and hrp then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local tc = plr.Character
                local th = tc and tc:FindFirstChildOfClass("Humanoid")
                local tr = tc and tc:FindFirstChild("HumanoidRootPart")
                if th and th.Health > 0 and tr then
